<footer>
  <div class="container">
    <div class="row g-4">
      <div class="col-md-4">
        <div class="footer-brand">
          <i class="fas fa-briefcase"></i>
          <%= appName || 'RexJobs' %>
          <span class="footer-dot"></span>
        </div>
        <p style="color:rgba(255,255,255,.6);font-size:.88rem">Your trusted partner for finding the perfect job. Connect with top companies and build your dream career.</p>
        <div class="d-flex gap-3 mt-3">
          <a href="#" style="color:rgba(255,255,255,.5);font-size:1.1rem"><i class="fab fa-linkedin-in"></i></a>
          <a href="#" style="color:rgba(255,255,255,.5);font-size:1.1rem"><i class="fab fa-twitter"></i></a>
          <a href="#" style="color:rgba(255,255,255,.5);font-size:1.1rem"><i class="fab fa-facebook-f"></i></a>
          <a href="#" style="color:rgba(255,255,255,.5);font-size:1.1rem"><i class="fab fa-instagram"></i></a>
        </div>
      </div>
      <div class="col-md-2">
        <h6 class="mb-3" style="font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:#64748b">Quick Links</h6>
        <ul class="list-unstyled" style="display:flex;flex-direction:column;gap:.5rem">
          <li><a href="/">Home</a></li>
          <li><a href="/jobs/category">Browse Jobs</a></li>
          <li><a href="/apply">Apply Now</a></li>
          <li><a href="/about">About Us</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div class="col-md-2">
        <h6 class="mb-3" style="font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:#64748b">For Employers</h6>
        <ul class="list-unstyled" style="display:flex;flex-direction:column;gap:.5rem">
          <li><a href="/employer/jobs/create">Post a Job</a></li>
          <li><a href="/employer/dashboard">Dashboard</a></li>
          <li><a href="/account/signup">Register</a></li>
        </ul>
      </div>
      <div class="col-md-4">
        <h6 class="mb-3" style="font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:#64748b">Stay Updated</h6>
        <p style="color:rgba(255,255,255,.6);font-size:.85rem;margin-bottom:1rem">Subscribe to get the latest job openings in your inbox.</p>
        <form id="newsletterForm">
          <div class="input-group">
            <input type="email" id="newsletterEmail" class="form-control" placeholder="your@email.com" required>
            <button class="btn btn-primary" type="submit"><i class="fas fa-paper-plane"></i></button>
          </div>
          <small id="newsletterMsg" class="d-block mt-2" style="color:rgba(255,255,255,.5)"></small>
        </form>
      </div>
    </div>

    <hr style="border-color:rgba(255,255,255,.08);margin:2.5rem 0 1.5rem">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
      <p style="margin:0;color:rgba(255,255,255,.4);font-size:.82rem">&copy; <%= new Date().getFullYear() %> <%= appName || 'RexJobs' %>. All rights reserved.</p>
      <div class="d-flex gap-3" style="font-size:.8rem">
        <a href="/privacy-policy">Privacy</a>
        <a href="/terms-and-conditions">Terms</a>
      </div>
    </div>
  </div>
</footer>

<script>
document.getElementById('newsletterForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const email = document.getElementById('newsletterEmail').value;
  const msgEl = document.getElementById('newsletterMsg');
  try {
    const r = await fetch('/newsletter', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({email}) });
    const d = await r.json();
    msgEl.style.color = d.statusCode===200 ? '#6ee7b7' : '#fca5a5';
    msgEl.textContent = d.msg;
    if (d.statusCode===200) document.getElementById('newsletterEmail').value='';
  } catch(err) { msgEl.textContent = 'Something went wrong.'; }
});
</script>
