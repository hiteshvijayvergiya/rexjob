<!-- Candidates Index - COMPLETE VIEW -->
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-md-6">
      <h2 class="fw-bold">Candidates</h2>
      <p class="text-muted">Manage all candidates</p>
    </div>
    <div class="col-md-6 text-end">
      <form action="/candidates" method="GET" class="d-inline-block">
        <div class="input-group">
          <input type="text" class="form-control" name="search" placeholder="Search candidates..." value="<%= search %>">
          <button class="btn btn-primary" type="submit">
            <i class="fas fa-search"></i> Search
          </button>
        </div>
      </form>
    </div>
  </div>

  <% if (candidates && candidates.length > 0) { %>
    <div class="card shadow-sm">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Mobile</th>
                <th>Location</th>
                <th>Experience</th>
                <th>Added Date</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% candidates.forEach(candidate => { %>
                <tr>
                  <td>
                    <strong><%= candidate.candidatename %></strong>
                  </td>
                  <td><%= candidate.candidateemail %></td>
                  <td><%= candidate.candidatemobile %></td>
                  <td><%= candidate.cityname || 'N/A' %></td>
                  <td><%= candidate.candidateexp || 0 %> years</td>
                  <td><%= moment(candidate.addeddate).format('DD MMM YYYY') %></td>
                  <td>
                    <% if (candidate.isactive) { %>
                      <span class="badge bg-success">Active</span>
                    <% } else { %>
                      <span class="badge bg-secondary">Inactive</span>
                    <% } %>
                  </td>
                  <td>
                    <a href="/candidates/<%= candidate.candidateid %>" class="btn btn-sm btn-primary">
                      <i class="fas fa-eye"></i> View
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Pagination -->
    <% if (pagination.totalPages > 1) { %>
      <nav aria-label="Candidates pagination" class="mt-4">
        <ul class="pagination justify-content-center">
          <li class="page-item <%= pagination.page === 1 ? 'disabled' : '' %>">
            <a class="page-link" href="?page=<%= pagination.page - 1 %>&search=<%= search %>">Previous</a>
          </li>
          
          <% for (let i = 1; i <= pagination.totalPages; i++) { %>
            <% if (i === 1 || i === pagination.totalPages || (i >= pagination.page - 2 && i <= pagination.page + 2)) { %>
              <li class="page-item <%= pagination.page === i ? 'active' : '' %>">
                <a class="page-link" href="?page=<%= i %>&search=<%= search %>"><%= i %></a>
              </li>
            <% } else if (i === pagination.page - 3 || i === pagination.page + 3) { %>
              <li class="page-item disabled"><span class="page-link">...</span></li>
            <% } %>
          <% } %>
          
          <li class="page-item <%= pagination.page === pagination.totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="?page=<%= pagination.page + 1 %>&search=<%= search %>">Next</a>
          </li>
        </ul>
      </nav>
    <% } %>

  <% } else { %>
    <div class="card shadow-sm">
      <div class="card-body text-center py-5">
        <i class="fas fa-users fa-3x text-muted mb-3"></i>
        <h4>No Candidates Found</h4>
        <p class="text-muted">No candidates have been added yet.</p>
      </div>
    </div>
  <% } %>
</div>
