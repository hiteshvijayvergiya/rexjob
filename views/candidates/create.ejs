<!-- candidates/create.ejs - CREATE CANDIDATE FORM WITH CATEGORY -->
<div class="container py-4">
  <div class="row">
    <div class="col-lg-10 mx-auto">
      
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Add New Candidate</h2>
        <a href="/candidates" class="btn btn-outline-secondary">
          <i class="fas fa-arrow-left me-2"></i>Back to List
        </a>
      </div>

      <form id="candidateForm" enctype="multipart/form-data" class="card shadow-sm">
        <div class="card-body p-4">
          
          <!-- Personal Information -->
          <h5 class="fw-bold mb-3 pb-2 border-bottom text-primary">
            <i class="fas fa-user me-2"></i>Personal Information
          </h5>
          
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Full Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" name="candidatename" required 
                     placeholder="Enter full name">
            </div>
            
            <div class="col-md-6 mb-3">
              <label class="form-label">Email Address <span class="text-danger">*</span></label>
              <input type="email" class="form-control" name="candidateemail" required
                     placeholder="candidate@email.com">
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Mobile Number <span class="text-danger">*</span></label>
              <input type="tel" class="form-control" name="candidatemobile" required 
                     pattern="[0-9]{10}" placeholder="10 digit mobile number">
              <small class="text-muted">Enter 10 digit mobile number</small>
            </div>
            
            <div class="col-md-6 mb-3">
              <label class="form-label">Total Experience (Years)</label>
              <input type="number" class="form-control" name="candidateexp" 
                     min="0" max="50" step="0.5" placeholder="e.g., 5">
            </div>
          </div>

          <!-- Category & Skills -->
          <h5 class="fw-bold mb-3 pb-2 border-bottom text-primary mt-4">
            <i class="fas fa-briefcase me-2"></i>Category & Skills
          </h5>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Job Category <span class="text-danger">*</span></label>
              <select class="form-select" name="candidatecategory" id="categorySelect" required>
                <option value="">Select Category</option>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.requirementtypeid %>"><%= cat.requirementtypename %></option>
                <% }); %>
              </select>
              <small class="text-muted">Primary field of expertise</small>
            </div>
            
            <div class="col-md-6 mb-3">
              <label class="form-label">Qualification <span class="text-danger">*</span></label>
              <input type="text" class="form-control" name="candidatequalification" required
                     placeholder="e.g., B.Tech, MBA, MCA">
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">Skills <span class="text-danger">*</span></label>
            <textarea class="form-control" name="candidateskill" rows="3" required
                      placeholder="e.g., Java, Spring Boot, MySQL, React, Node.js"></textarea>
            <small class="text-muted">Enter comma-separated skills</small>
          </div>

          <div class="mb-3">
            <label class="form-label">About Candidate</label>
            <textarea class="form-control" name="candidatedescription" rows="4"
                      placeholder="Brief description about candidate's background and expertise"></textarea>
          </div>

          <!-- Salary Information -->
          <h5 class="fw-bold mb-3 pb-2 border-bottom text-primary mt-4">
            <i class="fas fa-money-bill-wave me-2"></i>Salary Information
          </h5>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Current CTC (Annual)</label>
              <input type="text" class="form-control" name="candidatecurrentctc" 
                     placeholder="e.g., 5 LPA or 60,000">
            </div>
            
            <div class="col-md-6 mb-3">
              <label class="form-label">Expected CTC (Annual)</label>
              <input type="text" class="form-control" name="candidateexpectedctc" 
                     placeholder="e.g., 7 LPA or 80,000">
            </div>
          </div>

          <!-- Location Details -->
          <h5 class="fw-bold mb-3 pb-2 border-bottom text-primary mt-4">
            <i class="fas fa-map-marker-alt me-2"></i>Location Details
          </h5>

          <div class="row">
            <div class="col-md-4 mb-3">
              <label class="form-label">Country</label>
              <select class="form-select" name="candidatecountry" id="countrySelect">
                <option value="">Select Country</option>
                <% countries.forEach(country => { %>
                  <option value="<%= country.id %>" <%= country.id == 101 ? 'selected' : '' %>>
                    <%= country.name %>
                  </option>
                <% }); %>
              </select>
            </div>
            
            <div class="col-md-4 mb-3">
              <label class="form-label">State</label>
              <select class="form-select" name="candidatestate" id="stateSelect">
                <option value="">Select State</option>
                <% states.forEach(state => { %>
                  <option value="<%= state.id %>" data-country="<%= state.country_id %>">
                    <%= state.name %>
                  </option>
                <% }); %>
              </select>
            </div>
            
            <div class="col-md-4 mb-3">
              <label class="form-label">City</label>
              <select class="form-select" name="candidatecity" id="citySelect">
                <option value="">Select City</option>
                <% cities.forEach(city => { %>
                  <option value="<%= city.id %>" data-state="<%= city.state_id %>">
                    <%= city.name %>
                  </option>
                <% }); %>
              </select>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">Complete Address</label>
            <textarea class="form-control" name="candidateaddress" rows="2"
                      placeholder="Enter complete address"></textarea>
          </div>

          <!-- Resume Upload -->
          <h5 class="fw-bold mb-3 pb-2 border-bottom text-primary mt-4">
            <i class="fas fa-file-upload me-2"></i>Resume Upload
          </h5>

          <div class="mb-3">
            <label class="form-label">Upload Resume</label>
            <input type="file" class="form-control" name="resume" accept=".pdf,.doc,.docx">
            <small class="text-muted">Maximum file size: 5MB. Formats: PDF, DOC, DOCX</small>
          </div>

        </div>

        <div class="card-footer bg-light p-3">
          <div class="d-flex justify-content-between align-items-center">
            <a href="/candidates" class="btn btn-secondary">
              <i class="fas fa-times me-2"></i>Cancel
            </a>
            <button type="submit" class="btn btn-primary">
              <i class="fas fa-save me-2"></i>Add Candidate
            </button>
          </div>
        </div>
      </form>

      <div id="message" class="mt-3"></div>
    </div>
  </div>
</div>

<script>
// Filter states by country
document.getElementById('countrySelect').addEventListener('change', function() {
  const countryId = this.value;
  const stateSelect = document.getElementById('stateSelect');
  const stateOptions = stateSelect.querySelectorAll('option[data-country]');
  
  stateOptions.forEach(option => {
    if (!countryId || option.dataset.country === countryId) {
      option.style.display = '';
    } else {
      option.style.display = 'none';
    }
  });
  
  stateSelect.value = '';
  document.getElementById('citySelect').value = '';
});

// Filter cities by state
document.getElementById('stateSelect').addEventListener('change', function() {
  const stateId = this.value;
  const citySelect = document.getElementById('citySelect');
  const cityOptions = citySelect.querySelectorAll('option[data-state]');
  
  cityOptions.forEach(option => {
    if (!stateId || option.dataset.state === stateId) {
      option.style.display = '';
    } else {
      option.style.display = 'none';
    }
  });
  
  citySelect.value = '';
});

// Form submission with file upload
document.getElementById('candidateForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  
  const formData = new FormData(this);
  const submitBtn = this.querySelector('button[type="submit"]');
  const messageDiv = document.getElementById('message');
  
  // Disable submit button
  submitBtn.disabled = true;
  submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Adding Candidate...';
  
  try {
    const response = await fetch('/candidates/store', {
      method: 'POST',
      body: formData
    });
    
    const result = await response.json();
    
    if (result.statusCode === 200) {
      messageDiv.innerHTML = `<div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle me-2"></i>${result.msg}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>`;
      
      // Redirect after 1.5 seconds
      setTimeout(() => {
        window.location.href = '/candidates';
      }, 1500);
    } else {
      messageDiv.innerHTML = `<div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-circle me-2"></i>${result.msg}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>`;
      
      // Re-enable button
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<i class="fas fa-save me-2"></i>Add Candidate';
    }
  } catch (error) {
    console.error('Error:', error);
    messageDiv.innerHTML = `<div class="alert alert-danger alert-dismissible fade show">
      <i class="fas fa-exclamation-circle me-2"></i>Failed to add candidate. Please try again.
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>`;
    
    // Re-enable button
    submitBtn.disabled = false;
    submitBtn.innerHTML = '<i class="fas fa-save me-2"></i>Add Candidate';
  }
});

// Trigger state filter on page load if country is pre-selected
window.addEventListener('load', function() {
  const countrySelect = document.getElementById('countrySelect');
  if (countrySelect.value) {
    countrySelect.dispatchEvent(new Event('change'));
  }
});
</script>

<style>
.form-label {
  font-weight: 600;
  color: #2d3748;
}

.form-control:focus,
.form-select:focus {
  border-color: #667eea;
  box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
}

.text-primary {
  color: #667eea !important;
}

.border-primary {
  border-color: #667eea !important;
}
</style>
