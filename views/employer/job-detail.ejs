<div class="container mt-4 mb-5">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
      <a href="/employer/dashboard" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left"></i>
      </a>
      <div>
        <h4 class="fw-bold mb-0"><%= job.jobtitle %></h4>
        <div class="d-flex align-items-center gap-2 mt-1">
          <span class="badge bg-<%= aBadge[job.approvalstatus||0] %>">
            <%= aLabel[job.approvalstatus||0] %>
          </span>
          <% if (job.categoryname) { %>
          <span class="text-muted small"><i class="fas fa-folder me-1"></i><%= job.categoryname %></span>
          <% } %>
        </div>
      </div>
    </div>
    <a href="/employer/jobs/<%= job.jobid %>/edit" class="btn btn-outline-primary btn-sm">
      <i class="fas fa-edit me-1"></i>Edit Job
    </a>
  </div>

  <% if (job.approvalstatus == 2 && job.rejectionreason) { %>
  <div class="alert alert-danger mb-4">
    <i class="fas fa-times-circle me-2"></i>
    <strong>Rejected:</strong> <%= job.rejectionreason %>
    <a href="/employer/jobs/<%= job.jobid %>/edit" class="btn btn-sm btn-danger ms-3">Fix & Resubmit</a>
  </div>
  <% } else if (job.approvalstatus == 0) { %>
  <div class="alert alert-warning mb-4">
    <i class="fas fa-clock me-2"></i>
    This job is <strong>pending admin approval</strong>. It will be visible on the site once approved.
  </div>
  <% } else if (job.approvalstatus == 1) { %>
  <div class="alert alert-success mb-4">
    <i class="fas fa-check-circle me-2"></i>
    This job is <strong>live</strong> and visible to candidates.
    <a href="/jobs/<%= job.jobid %>" target="_blank" class="ms-2">View on site →</a>
  </div>
  <% } %>

  <div class="row g-4">
    <!-- Job Summary -->
    <div class="col-lg-4">
      <div class="form-card">
        <h6 class="fw-bold mb-3">Job Summary</h6>
        <div class="mb-2 small"><span class="text-muted">Type:</span> <strong><%= job.jobtype==1?'Full-time':job.jobtype==2?'Part-time':job.jobtype==3?'Contract':'Internship' %></strong></div>
        <% if (job.expstart || job.expend) { %>
        <div class="mb-2 small"><span class="text-muted">Experience:</span> <strong><%= job.expstart||0 %>–<%= job.expend||0 %> yrs</strong></div>
        <% } %>
        <% if (job.salarystart || job.salaryend) { %>
        <div class="mb-2 small"><span class="text-muted">Salary:</span> <strong>₹<%= job.salarystart %>–₹<%= job.salaryend %> LPA</strong></div>
        <% } %>
        <div class="mb-2 small"><span class="text-muted">Openings:</span> <strong><%= job.noofopenings||1 %></strong></div>
        <div class="mb-2 small"><span class="text-muted">Posted:</span> <strong><%= moment(job.addeddate).format('DD MMM YYYY') %></strong></div>
        <div class="mt-3 pt-3 border-top text-center">
          <div class="fw-bold fs-2 text-primary"><%= apps.length %></div>
          <div class="text-muted small">Total Applications</div>
        </div>
      </div>
    </div>

    <!-- Applications -->
    <div class="col-lg-8">
      <div class="admin-table">
        <div class="p-3 border-bottom">
          <h6 class="fw-bold mb-0"><i class="fas fa-file-alt me-2 text-primary"></i>Applications (<%= apps.length %>)</h6>
        </div>

        <% if (apps.length) { %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr><th>Applicant</th><th>Experience</th><th>Applied</th><th>Status</th><th>Resume</th></tr>
            </thead>
            <tbody>
              <% for (const a of apps) { %>
              <tr>
                <td>
                  <div class="fw-semibold small"><%= a.fullname %></div>
                  <div class="text-muted" style="font-size:.78rem"><%= a.email %></div>
                </td>
                <td class="small"><%= a.expyear %>y <%= a.expmonth %>m</td>
                <td class="text-muted small"><%= moment(a.addeddate).format('DD MMM') %></td>
                <td>
                  <span class="badge bg-<%= statusBadge[a.status||0] %>"><%= statusLabels[a.status||0] %></span>
                </td>
                <td>
                  <% if (a.resumepath) { %>
                  <a href="<%= a.resumepath %>" target="_blank" class="btn btn-sm btn-outline-success py-0 px-2">
                    <i class="fas fa-file-pdf"></i>
                  </a>
                  <% } else { %>—<% } %>
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <% } else { %>
        <div class="text-center py-5 text-muted">
          <i class="fas fa-inbox fa-3x mb-3 d-block" style="opacity:.15"></i>
          <p>No applications yet.</p>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
