<!-- Jobs Index - COMPLETE VIEW -->
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-md-6">
      <h2 class="fw-bold">Manage Jobs</h2>
      <p class="text-muted">Post and manage job listings</p>
    </div>
    <div class="col-md-6 text-end">
      <a href="/jobs/create" class="btn btn-primary me-2">
        <i class="fas fa-plus"></i> Post New Job
      </a>
      <form action="/jobs" method="GET" class="d-inline-block">
        <div class="input-group" style="width: 300px; display: inline-flex;">
          <input type="text" class="form-control" name="search" placeholder="Search jobs..." value="<%= search %>">
          <button class="btn btn-outline-primary" type="submit">
            <i class="fas fa-search"></i>
          </button>
        </div>
      </form>
    </div>
  </div>

  <% if (jobs && jobs.length > 0) { %>
    <div class="row">
      <% jobs.forEach(job => { %>
        <div class="col-md-6 col-lg-4 mb-4">
          <div class="card h-100 shadow-sm job-card">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <h5 class="card-title mb-0"><%= job.requirementname %></h5>
                <% if (job.isactive) { %>
                  <span class="badge bg-success">Active</span>
                <% } else { %>
                  <span class="badge bg-secondary">Inactive</span>
                <% } %>
              </div>
              
              <p class="text-muted small mb-2">
                <i class="fas fa-briefcase me-1"></i><%= job.requirementpositionname %>
              </p>
              
              <p class="text-muted small mb-2">
                <i class="fas fa-map-marker-alt me-1"></i><%= job.cityname || 'Not specified' %>
              </p>
              
              <p class="card-text small text-muted mb-3">
                <%= job.requirementdescription ? job.requirementdescription.substring(0, 100) + '...' : 'No description' %>
              </p>
              
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <small class="text-muted">
                    <i class="far fa-calendar me-1"></i>
                    <%= moment(job.addeddate).format('DD MMM YYYY') %>
                  </small>
                  <br>
                  <small class="text-primary">
                    <i class="fas fa-users me-1"></i>
                    <%= job.applicationcount %> Applications
                  </small>
                </div>
                <div class="btn-group">
                  <a href="/jobs/<%= job.requirementid %>/edit" class="btn btn-sm btn-outline-primary">
                    <i class="fas fa-edit"></i>
                  </a>
                  <button onclick="deleteJob(<%= job.requirementid %>)" class="btn btn-sm btn-outline-danger">
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- Pagination -->
    <% if (pagination.totalPages > 1) { %>
      <nav aria-label="Jobs pagination" class="mt-4">
        <ul class="pagination justify-content-center">
          <li class="page-item <%= pagination.page === 1 ? 'disabled' : '' %>">
            <a class="page-link" href="?page=<%= pagination.page - 1 %>&search=<%= search %>">Previous</a>
          </li>
          
          <% for (let i = 1; i <= pagination.totalPages; i++) { %>
            <% if (i === 1 || i === pagination.totalPages || (i >= pagination.page - 2 && i <= pagination.page + 2)) { %>
              <li class="page-item <%= pagination.page === i ? 'active' : '' %>">
                <a class="page-link" href="?page=<%= i %>&search=<%= search %>"><%= i %></a>
              </li>
            <% } else if (i === pagination.page - 3 || i === pagination.page + 3) { %>
              <li class="page-item disabled"><span class="page-link">...</span></li>
            <% } %>
          <% } %>
          
          <li class="page-item <%= pagination.page === pagination.totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="?page=<%= pagination.page + 1 %>&search=<%= search %>">Next</a>
          </li>
        </ul>
      </nav>
    <% } %>

  <% } else { %>
    <div class="card shadow-sm">
      <div class="card-body text-center py-5">
        <i class="fas fa-briefcase fa-3x text-muted mb-3"></i>
        <h4>No Jobs Found</h4>
        <p class="text-muted mb-4">
          <% if (search) { %>
            No jobs match your search criteria.
          <% } else { %>
            You haven't posted any jobs yet.
          <% } %>
        </p>
        <a href="/jobs/create" class="btn btn-primary">
          <i class="fas fa-plus me-2"></i>Post Your First Job
        </a>
      </div>
    </div>
  <% } %>
</div>

<script>
async function deleteJob(jobId) {
  if (!confirm('Are you sure you want to delete this job?')) {
    return;
  }
  
  try {
    const response = await fetch(`/jobs/${jobId}/delete`, {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' }
    });
    
    const result = await response.json();
    
    if (result.statusCode === 200) {
      alert(result.msg);
      location.reload();
    } else {
      alert(result.msg);
    }
  } catch (error) {
    alert('Failed to delete job');
  }
}
</script>

<style>
.job-card {
  transition: all 0.3s ease;
}

.job-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
}
</style>
