<!-- Jobs Create - COMPLETE VIEW -->
<div class="container py-4">
  <div class="row">
    <div class="col-lg-10 mx-auto">
      <h2 class="fw-bold mb-4">Post New Job</h2>
      
      <form id="jobForm" class="card shadow-sm">
        <div class="card-body p-4">
          <div class="row">
            <div class="col-md-8 mb-3">
              <label class="form-label">Job Title <span class="text-danger">*</span></label>
              <input type="text" class="form-control" name="requirementname" required>
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Number of Openings</label>
              <input type="number" class="form-control" name="noofrequirement" min="1" value="1">
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Category <span class="text-danger">*</span></label>
              <select class="form-select" name="requirementtypeid" id="categorySelect" required>
                <option value="">Select Category</option>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.requirementtypeid %>"><%= cat.requirementtypename %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Position/Technology <span class="text-danger">*</span></label>
              <select class="form-select" name="requirementpositionid" id="positionSelect" required>
                <option value="">Select Position</option>
                <% positions.forEach(pos => { %>
                  <option value="<%= pos.requirementpositionid %>" data-category="<%= pos.requirementtypeid %>">
                    <%= pos.requirementpositionname %>
                  </option>
                <% }); %>
              </select>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Location <span class="text-danger">*</span></label>
              <select class="form-select" name="requirementcity" required>
                <option value="">Select City</option>
                <% cities.forEach(city => { %>
                  <option value="<%= city.id %>"><%= city.name %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Priority</label>
              <select class="form-select" name="requirementpriorityid">
                <option value="">Select Priority</option>
                <% priorities.forEach(pri => { %>
                  <option value="<%= pri.requirementpriorityid %>"><%= pri.requirementpriorityname %></option>
                <% }); %>
              </select>
            </div>
          </div>

          <div class="row">
            <div class="col-md-3 mb-3">
              <label class="form-label">Min Experience (Years)</label>
              <input type="number" class="form-control" name="expstart" min="0" value="0">
            </div>
            <div class="col-md-3 mb-3">
              <label class="form-label">Max Experience (Years)</label>
              <input type="number" class="form-control" name="expend" min="0" value="5">
            </div>
            <div class="col-md-3 mb-3">
              <label class="form-label">Min Salary (LPA)</label>
              <input type="number" class="form-control" name="salarystart" min="0" step="0.5">
            </div>
            <div class="col-md-3 mb-3">
              <label class="form-label">Max Salary (LPA)</label>
              <input type="number" class="form-control" name="salaryend" min="0" step="0.5">
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Job Type <span class="text-danger">*</span></label>
              <select class="form-select" name="jobtype" required>
                <option value="">Select Type</option>
                <option value="1">Full Time</option>
                <option value="2">Part Time</option>
                <option value="3">Contract</option>
                <option value="4">Internship</option>
              </select>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Required Documents</label>
              <input type="text" class="form-control" name="requirementdocument" placeholder="e.g., Resume, Cover Letter">
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">Job Description <span class="text-danger">*</span></label>
            <textarea class="form-control" name="requirementdescription" rows="5" required placeholder="Describe the role, responsibilities, and what you're looking for..."></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label">Required Skills</label>
            <textarea class="form-control" name="requirementskill" rows="4" placeholder="List required technical and soft skills..."></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label">Key Responsibilities</label>
            <textarea class="form-control" name="requirementresponsibility" rows="4" placeholder="What will the candidate be responsible for?"></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label">Education Requirements</label>
            <textarea class="form-control" name="requirementeducation" rows="3" placeholder="Required educational qualifications..."></textarea>
          </div>
        </div>

        <div class="card-footer bg-light p-3">
          <div class="d-flex justify-content-between">
            <a href="/jobs" class="btn btn-secondary">
              <i class="fas fa-times me-2"></i>Cancel
            </a>
            <button type="submit" class="btn btn-primary">
              <i class="fas fa-check me-2"></i>Post Job
            </button>
          </div>
        </div>
      </form>

      <div id="message" class="mt-3"></div>
    </div>
  </div>
</div>

<script>
// Filter positions by category
document.getElementById('categorySelect').addEventListener('change', function() {
  const categoryId = this.value;
  const positionSelect = document.getElementById('positionSelect');
  const options = positionSelect.querySelectorAll('option[data-category]');
  
  options.forEach(option => {
    if (!categoryId || option.dataset.category === categoryId) {
      option.style.display = '';
    } else {
      option.style.display = 'none';
    }
  });
  
  positionSelect.value = '';
});

// Form submission
document.getElementById('jobForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  
  const formData = new FormData(this);
  const data = Object.fromEntries(formData);
  const submitBtn = this.querySelector('button[type="submit"]');
  const messageDiv = document.getElementById('message');
  
  submitBtn.disabled = true;
  submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Posting...';
  
  try {
    const response = await fetch('/jobs/store', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    
    const result = await response.json();
    
    if (result.statusCode === 200) {
      messageDiv.innerHTML = `<div class="alert alert-success">${result.msg}</div>`;
      setTimeout(() => window.location.href = '/jobs', 1500);
    } else {
      messageDiv.innerHTML = `<div class="alert alert-danger">${result.msg}</div>`;
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<i class="fas fa-check me-2"></i>Post Job';
    }
  } catch (error) {
    messageDiv.innerHTML = '<div class="alert alert-danger">Failed to post job. Please try again.</div>';
    submitBtn.disabled = false;
    submitBtn.innerHTML = '<i class="fas fa-check me-2"></i>Post Job';
  }
});
</script>
