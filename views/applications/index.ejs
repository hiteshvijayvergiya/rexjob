<!-- Applications Index - COMPLETE VIEW -->
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-md-4">
      <h2 class="fw-bold">Job Applications</h2>
      <p class="text-muted">Manage all job applications</p>
    </div>
    <div class="col-md-8">
      <div class="row g-2">
        <div class="col-md-6">
          <select class="form-select" onchange="window.location.href='?job='+this.value+'&search=<%= search %>'">
            <option value="0">All Jobs</option>
            <% jobs.forEach(job => { %>
              <option value="<%= job.value %>" <%= jobId == job.value ? 'selected' : '' %>>
                <%= job.text %>
              </option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-6">
          <form action="/applications" method="GET" class="d-flex gap-2">
            <input type="hidden" name="job" value="<%= jobId %>">
            <input type="text" class="form-control" name="search" placeholder="Search applicants..." value="<%= search %>">
            <button class="btn btn-primary" type="submit">
              <i class="fas fa-search"></i>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <% if (applications && applications.length > 0) { %>
    <div class="card shadow-sm">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Applicant Name</th>
                <th>Job</th>
                <th>Email</th>
                <th>Mobile</th>
                <th>Experience</th>
                <th>Applied Date</th>
                <th>Resume</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% applications.forEach(app => { %>
                <tr>
                  <td><strong><%= app.applyjobname %></strong></td>
                  <td>
                    <%= app.requirementname %><br>
                    <small class="text-muted"><%= app.requirementpositionname %></small>
                  </td>
                  <td><%= app.applyjobemail %></td>
                  <td><%= app.applyjobmobile %></td>
                  <td><%= app.expyear || 0 %> yrs <%= app.expmonth || 0 %> months</td>
                  <td><%= moment(app.addeddate).format('DD MMM YYYY') %></td>
                  <td>
                    <% if (app.applyjobresume) { %>
                      <a href="<%= app.applyjobresume %>" target="_blank" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-download"></i> Download
                      </a>
                    <% } else { %>
                      <span class="text-muted">No resume</span>
                    <% } %>
                  </td>
                  <td>
                    <a href="/applications/<%= app.applyjobid %>" class="btn btn-sm btn-primary">
                      <i class="fas fa-eye"></i> View
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Pagination -->
    <% if (pagination.totalPages > 1) { %>
      <nav aria-label="Applications pagination" class="mt-4">
        <ul class="pagination justify-content-center">
          <li class="page-item <%= pagination.page === 1 ? 'disabled' : '' %>">
            <a class="page-link" href="?page=<%= pagination.page - 1 %>&job=<%= jobId %>&search=<%= search %>">Previous</a>
          </li>
          
          <% for (let i = 1; i <= pagination.totalPages; i++) { %>
            <% if (i === 1 || i === pagination.totalPages || (i >= pagination.page - 2 && i <= pagination.page + 2)) { %>
              <li class="page-item <%= pagination.page === i ? 'active' : '' %>">
                <a class="page-link" href="?page=<%= i %>&job=<%= jobId %>&search=<%= search %>"><%= i %></a>
              </li>
            <% } else if (i === pagination.page - 3 || i === pagination.page + 3) { %>
              <li class="page-item disabled"><span class="page-link">...</span></li>
            <% } %>
          <% } %>
          
          <li class="page-item <%= pagination.page === pagination.totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="?page=<%= pagination.page + 1 %>&job=<%= jobId %>&search=<%= search %>">Next</a>
          </li>
        </ul>
      </nav>
    <% } %>

  <% } else { %>
    <div class="card shadow-sm">
      <div class="card-body text-center py-5">
        <i class="fas fa-file-alt fa-3x text-muted mb-3"></i>
        <h4>No Applications Found</h4>
        <p class="text-muted">
          <% if (jobId > 0 || search) { %>
            No applications match your search criteria.
          <% } else { %>
            No one has applied for jobs yet.
          <% } %>
        </p>
      </div>
    </div>
  <% } %>
</div>
