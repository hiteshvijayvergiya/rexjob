<!-- views/error/404.ejs -->
<div class="container text-center mt-5 py-5">
  <div style="font-size:6rem;color:#e2e8f0;font-weight:900">404</div>
  <h3 class="fw-bold mt-3">Page Not Found</h3>
  <p class="text-muted"><%= typeof message !== 'undefined' ? message : 'The page you are looking for does not exist.' %></p>
  <a href="/" class="btn btn-primary mt-3 px-5">Go Home</a>
</div>
