<!-- CTA -->
<section style="background:linear-gradient(135deg,#0f172a,#1e3a8a);padding:5rem 0">
  <div class="container text-center">
    <h2 style="color:#fff;margin-bottom:.75rem">Ready to Start Your Journey?</h2>
    <p style="color:rgba(255,255,255,.7);font-size:1.1rem;margin-bottom:2rem">Join thousands of professionals who found their dream jobs through <%= appName || 'RexJobs' %>.</p>
    <div class="d-flex gap-3 justify-content-center flex-wrap">
      <a href="/account/signup" class="btn btn-accent btn-lg"><i class="fas fa-user-plus me-2"></i>Create Free Account</a>
      <a href="/jobs/category" class="btn btn-light btn-lg"><i class="fas fa-search me-2"></i>Browse Jobs</a>
    </div>
  </div>
</section>
