<!-- HERO -->
<section class="hero-section">
  <div class="container" style="position:relative;z-index:1">
    <div class="row align-items-center g-4" style="padding-bottom:3rem">
      <div class="col-lg-6">
        <div class="hero-pill">
          <span>NEW</span> Jobs updated daily across India
        </div>
        <h1 class="mb-3" style="color:#fff">Find Your <span style="color:#f59e0b">Dream Job</span> Today</h1>
        <p style="font-size:1.15rem;color:rgba(255,255,255,.8);margin-bottom:2rem">
          Connect with top companies and explore thousands of opportunities. Your next career move starts here.
        </p>
        <div class="d-flex gap-3 flex-wrap">
          <a href="/jobs/category" class="btn btn-accent btn-lg"><i class="fas fa-search"></i> Browse All Jobs</a>
          <a href="/apply" class="btn btn-light btn-lg"><i class="fas fa-file-upload"></i> Submit Resume</a>
        </div>
        <div class="d-flex gap-4 mt-4">
          <div><div class="stat-num" style="color:#f59e0b;font-size:1.75rem"><%= stats && stats.jobs || '500+' %></div><small style="color:rgba(255,255,255,.6)">Live Jobs</small></div>
          <div><div class="stat-num" style="color:#f59e0b;font-size:1.75rem"><%= stats && stats.categories || '50+' %></div><small style="color:rgba(255,255,255,.6)">Categories</small></div>
          <div><div class="stat-num" style="color:#f59e0b;font-size:1.75rem"><%= stats && stats.applications || '1k+' %></div><small style="color:rgba(255,255,255,.6)">Applications</small></div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="hero-search-card">
          <h5 class="mb-1" style="font-family:'Syne',sans-serif">Quick Job Search</h5>
          <p class="text-muted small mb-3">Find jobs by keyword or category</p>
          <form action="/jobs/category" method="GET">
            <div class="search-bar mb-3">
              <i class="fas fa-search" style="color:#94a3b8"></i>
              <input type="text" name="search" placeholder="Job title, skill, keyword...">
              <button type="submit" class="btn btn-primary btn-sm">Search</button>
            </div>
            <div class="d-grid" style="grid-template-columns:1fr 1fr;gap:.75rem">
              <select name="category" class="form-select">
                <option value="">All Categories</option>
                <% for (const c of (categories||[])) { %>
                <option value="<%= c.categoryid %>"><%= c.categoryname %></option>
                <% } %>
              </select>
              <button type="submit" class="btn btn-primary w-100"><i class="fas fa-filter me-1"></i>Find Jobs</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- JOB CATEGORIES -->
<section class="section section-light">
  <div class="container">
    <div class="text-center mb-5">
      <div class="badge bg-primary mb-2"><i class="fas fa-th-large me-1"></i>Categories</div>
      <h2 class="section-title">Browse by Category</h2>
      <p class="section-subtitle">Explore opportunities across every industry</p>
    </div>
    <div class="row g-3">
      <% const catIcons = ['fa-laptop-code','fa-chart-line','fa-palette','fa-cogs','fa-heartbeat','fa-graduation-cap','fa-building','fa-shopping-cart','fa-truck','fa-camera','fa-calculator','fa-gavel']; %>
      <% for (let i=0; i<Math.min((categories||[]).length, 12); i++) { const c = categories[i]; %>
      <div class="col-6 col-md-3 col-lg-2">
        <a href="/jobs/category/<%= c.categoryid %>" class="cat-card">
          <div class="cat-icon"><i class="fas <%= catIcons[i%catIcons.length] %>"></i></div>
          <h6><%= c.categoryname %></h6>
          <small><%= c.jobcount || 0 %> jobs</small>
        </a>
      </div>
      <% } %>
    </div>
    <div class="text-center mt-4">
      <a href="/jobs/category" class="btn btn-outline-primary">View All Categories <i class="fas fa-arrow-right ms-1"></i></a>
    </div>
  </div>
</section>

<!-- LATEST JOBS -->
<section class="section">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="section-title mb-1">Latest Openings</h2>
        <p class="text-muted mb-0">Fresh opportunities updated daily</p>
      </div>
      <a href="/jobs/category" class="btn btn-outline-primary d-sm-none" style="display:none!important">View All</a>
      <a href="/jobs/category" class="btn btn-primary">View All Jobs</a>
    </div>
    <div class="row g-3">
      <% if ((jobs||[]).length) { %>
        <% for (const job of jobs) { %>
        <div class="col-lg-6">
          <a href="/jobs/<%= job.jobid %>" class="job-card" style="text-decoration:none">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <div class="job-title"><%= job.jobtitle %></div>
                <div class="job-company"><i class="fas fa-building me-1"></i><%= job.postername || 'Company' %></div>
              </div>
              <% if (job.jobtype) { const jtypes=['','Full-time','Part-time','Contract','Internship']; %>
              <span class="badge bg-primary"><%= jtypes[job.jobtype]||'Full-time' %></span>
              <% } %>
            </div>
            <div class="job-tags">
              <% if (job.categoryname) { %><span class="job-tag"><i class="fas fa-folder me-1"></i><%= job.categoryname %></span><% } %>
              <% if (job.expstart || job.expend) { %><span class="job-tag"><i class="fas fa-clock me-1"></i><%= job.expstart||0 %>-<%= job.expend||0 %> yrs</span><% } %>
              <% if (job.salarystart || job.salaryend) { %><span class="job-tag blue"><i class="fas fa-rupee-sign me-1"></i><%= job.salarystart %>-<%= job.salaryend %> LPA</span><% } %>
            </div>
            <div class="job-footer">
              <small class="text-muted"><i class="fas fa-calendar-alt me-1"></i><%= moment ? moment(job.addeddate).fromNow() : '' %></small>
              <span class="btn btn-outline-primary btn-sm">View Details <i class="fas fa-arrow-right ms-1"></i></span>
            </div>
          </a>
        </div>
        <% } %>
      <% } else { %>
      <div class="col-12 text-center py-5">
        <i class="fas fa-briefcase fa-3x mb-3 d-block" style="color:#cbd5e1"></i>
        <p class="text-muted">No jobs available right now. Check back soon!</p>
        <a href="/apply" class="btn btn-primary">Submit Your Resume</a>
      </div>
      <% } %>
    </div>
  </div>
</section>

<!-- WHY CHOOSE US -->
