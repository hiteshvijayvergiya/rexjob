<!-- views/front/contact.ejs -->
<div class="container mt-5 mb-5"><div class="row justify-content-center"><div class="col-lg-6">
  <h2 class="fw-bold mb-4">Contact Us</h2>
  <div class="form-card">
    <div class="mb-3"><label class="form-label">Name</label><input type="text" class="form-control" placeholder="Your name"></div>
    <div class="mb-3"><label class="form-label">Email</label><input type="email" class="form-control" placeholder="your@email.com"></div>
    <div class="mb-3"><label class="form-label">Message</label><textarea class="form-control" rows="5" placeholder="Your message..."></textarea></div>
    <button class="btn btn-primary px-4">Send Message</button>
  </div>
</div></div></div>
