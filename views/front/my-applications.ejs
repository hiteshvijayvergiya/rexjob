<!-- views/front/my-applications.ejs -->
<div class="container mt-4 mb-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="fas fa-list me-2 text-primary"></i>My Applications</h4>
    <a href="/apply" class="btn btn-primary btn-sm"><i class="fas fa-paper-plane me-1"></i>Apply for New Job</a>
  </div>

  <% if (apps.length) { %>
  <div class="admin-table">
    <div class="table-responsive">
      <table class="table mb-0">
        <thead><tr><th>Job</th><th>Category</th><th>Applied On</th><th>Status</th><th>Resume</th></tr></thead>
        <tbody>
          <% const sBadge = ['secondary','success','info','primary','danger','warning']; %>
          <% for (const a of apps) { %>
          <tr>
            <td><div class="fw-semibold"><%= a.jobtitle %></div></td>
            <td class="text-muted small"><%= a.categoryname || '-' %></td>
            <td class="text-muted small"><%= moment(a.addeddate).format('DD MMM YYYY') %></td>
            <td><span class="badge bg-<%= sBadge[a.status||0] %>"><%= statusLabels[a.status||0] %></span></td>
            <td>
              <% if (a.resumepath) { %>
                <a href="<%= a.resumepath %>" target="_blank" class="btn btn-sm btn-outline-success"><i class="fas fa-file-pdf"></i></a>
              <% } else { %>
                <span class="text-muted small">—</span>
              <% } %>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <% } else { %>
  <div class="text-center py-5">
    <i class="fas fa-clipboard-list fa-4x mb-3 text-muted" style="opacity:.2"></i>
    <h5 class="text-muted">You haven't applied for any jobs yet</h5>
    <a href="/jobs/category" class="btn btn-primary mt-3">Browse Jobs</a>
  </div>
  <% } %>
</div>
