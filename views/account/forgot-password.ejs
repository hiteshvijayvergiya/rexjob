<!-- views/account/forgot-password.ejs -->
<h5 class="fw-bold mb-1">Forgot Password?</h5>
<p class="text-muted small mb-4">Enter your email and we'll send a reset link.</p>
<form method="POST" action="/account/forgot-password">
  <div class="mb-4">
    <label class="form-label">Email</label>
    <input type="email" name="email" class="form-control" required placeholder="you@email.com" autofocus>
  </div>
  <button type="submit" class="btn btn-primary w-100 py-2">Send Reset Link</button>
</form>
<div class="text-center mt-3"><a href="/account/login" class="small text-primary">← Back to Login</a></div>
