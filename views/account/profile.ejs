<!-- views/account/profile.ejs -->
<div class="container mt-4 mb-5">
  <div class="row g-4">

    <!-- Left: Profile Form -->
    <div class="col-lg-4">
      <div class="form-card text-center mb-4">
        <div class="mb-3"><i class="fas fa-user-circle fa-5x text-primary" style="opacity:.6"></i></div>
        <h5 class="fw-bold mb-0"><%= user.fname %> <%= user.lname %></h5>
        <p class="text-muted small mb-0"><%= user.useremail %></p>
        <% if (user.isadmin || user.issuperadmin) { %>
          <span class="badge bg-primary mt-2">Admin</span>
        <% } else if (user.usertypeid === 3) { %>
          <span class="badge bg-warning text-dark mt-2">Employer</span>
        <% } else { %>
          <span class="badge bg-success mt-2">Job Seeker</span>
        <% } %>
      </div>

      <div class="form-card">
        <h6 class="fw-bold mb-3">Edit Profile</h6>
        <form method="POST" action="/account/profile">
          <div class="mb-3">
            <label class="form-label">First Name</label>
            <input type="text" name="fname" class="form-control" value="<%= user.fname %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Last Name</label>
            <input type="text" name="lname" class="form-control" value="<%= user.lname %>">
          </div>
          <div class="mb-3">
            <label class="form-label">Mobile</label>
            <input type="tel" name="mobile" class="form-control" value="<%= user.mobile || '' %>">
          </div>
          <button type="submit" class="btn btn-primary w-100">Save Changes</button>
        </form>
      </div>
    </div>

    <!-- Right: My Jobs (Employer) or My Apps (Candidate) -->
    <div class="col-lg-8">

      <% if (myJobs && myJobs.length >= 0 && (user.usertypeid === 3 || user.isadmin)) { %>
      <!-- EMPLOYER: My Posted Jobs -->
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0">My Posted Jobs</h5>
        <a href="/admin/jobs/create" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i>Post New Job</a>
      </div>
      <% if (myJobs.length) { %>
      <div class="admin-table mb-4">
        <div class="table-responsive">
          <table class="table mb-0">
            <thead><tr><th>Job Title</th><th>Category</th><th>Apps</th><th>Status</th><th>Date</th></tr></thead>
            <tbody>
              <% for (const j of myJobs) { %>
              <tr>
                <td><a href="/admin/jobs/<%= j.jobid %>/edit" class="fw-semibold text-dark"><%= j.jobtitle %></a></td>
                <td class="small text-muted"><%= j.categoryname || '-' %></td>
                <td class="text-center"><span class="badge bg-light text-dark border"><%= j.appcount %></span></td>
                <td>
                  <span class="badge job-badge <%= j.approvalstatus==0?'badge-pending':j.approvalstatus==1?'badge-approved':'badge-rejected' %>">
                    <%= approvalLabels[j.approvalstatus] || 'Unknown' %>
                  </span>
                </td>
                <td class="small text-muted"><%= moment(j.addeddate).format('DD MMM YYYY') %></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
      <% } else { %>
      <div class="form-card text-center text-muted py-5 mb-4">
        <i class="fas fa-briefcase fa-3x mb-3" style="opacity:.2"></i>
        <p>You haven't posted any jobs yet.</p>
        <a href="/admin/jobs/create" class="btn btn-primary">Post First Job</a>
      </div>
      <% } %>
      <% } %>

      <!-- Quick Links -->
      <div class="form-card">
        <h6 class="fw-bold mb-3">Quick Actions</h6>
        <div class="d-flex gap-2 flex-wrap">
          <a href="/my-applications" class="btn btn-outline-primary btn-sm">
            <i class="fas fa-list me-1"></i>My Applications
          </a>
          <a href="/apply" class="btn btn-outline-primary btn-sm">
            <i class="fas fa-paper-plane me-1"></i>Submit Resume
          </a>
          <a href="/jobs/category" class="btn btn-outline-primary btn-sm">
            <i class="fas fa-search me-1"></i>Browse Jobs
          </a>
          <% if (user.isadmin || user.issuperadmin) { %>
          <a href="/admin/dashboard" class="btn btn-outline-primary btn-sm">
            <i class="fas fa-tachometer-alt me-1"></i>Admin Panel
          </a>
          <% } %>
        </div>
      </div>

    </div>
  </div>
</div>
