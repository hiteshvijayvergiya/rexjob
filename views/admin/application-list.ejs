<!-- views/admin/application-list.ejs -->
<div class="admin-wrapper">
  <%- include('../partials/adminsidebar') %>
  <div class="admin-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h4 class="fw-bold mb-0"><i class="fas fa-file-alt me-2 text-primary"></i>Applications</h4>
    </div>

    <form class="row g-2 mb-3" method="GET" action="/admin/applications">
      <div class="col-md-5">
        <input type="text" name="search" class="form-control" placeholder="Search name or email..." value="<%= search %>">
      </div>
      <div class="col-md-3">
        <select name="job" class="form-select">
          <option value="">All Jobs</option>
          <% for (const j of jobs) { %>
          <option value="<%= j.value %>" <%= jobFilter == j.value ? 'selected':'' %>><%= j.text %></option>
          <% } %>
        </select>
      </div>
      <div class="col-md-2">
        <button class="btn btn-outline-primary w-100">Filter</button>
      </div>
      <div class="col-md-2">
        <a href="/admin/applications" class="btn btn-outline-secondary w-100">Reset</a>
      </div>
    </form>

    <div class="admin-table">
      <div class="table-responsive">
        <table class="table mb-0">
          <thead><tr><th>Applicant</th><th>Job</th><th>Experience</th><th>Expected Salary</th><th>Status</th><th>Date</th><th>Actions</th></tr></thead>
          <tbody>
            <% const sBadge = ['secondary','success','info','primary','danger','warning']; %>
            <% for (const a of apps) { %>
            <tr>
              <td>
                <div class="fw-semibold"><%= a.fullname %></div>
                <div class="text-muted small"><%= a.email %></div>
                <div class="text-muted small"><%= a.mobile %></div>
              </td>
              <td class="small"><%= a.jobtitle %><br><span class="text-muted"><%= a.categoryname %></span></td>
              <td class="small"><%= a.expyear %>y <%= a.expmonth %>m</td>
              <td class="small"><%= a.expectedsalary ? '₹'+Number(a.expectedsalary).toLocaleString() : '-' %></td>
              <td>
                <select class="form-select form-select-sm status-select" data-id="<%= a.applicationid %>" style="width:120px">
                  <% for (let i=0;i<statusLabels.length;i++) { %>
                  <option value="<%= i %>" <%= a.status==i?'selected':'' %>><%= statusLabels[i] %></option>
                  <% } %>
                </select>
              </td>
              <td class="text-muted small"><%= moment(a.addeddate).format('DD MMM YYYY') %></td>
              <td>
                <a href="/admin/applications/<%= a.applicationid %>" class="btn btn-sm btn-outline-primary">
                  <i class="fas fa-eye"></i>
                </a>
                <% if (a.resumepath) { %>
                <a href="<%= a.resumepath %>" target="_blank" class="btn btn-sm btn-outline-success ms-1">
                  <i class="fas fa-file-pdf"></i>
                </a>
                <% } %>
              </td>
            </tr>
            <% } %>
            <% if (!apps.length) { %>
              <tr><td colspan="7" class="text-center py-5 text-muted">No applications found.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% if (pagination.totalPages > 1) { %>
      <div class="p-3 border-top d-flex justify-content-between align-items-center">
        <span class="text-muted small">Page <%= pagination.page %> of <%= pagination.totalPages %></span>
        <nav><ul class="pagination pagination-sm mb-0">
          <% for (let p=1;p<=pagination.totalPages;p++) { %>
          <li class="page-item <%= p===pagination.page?'active':'' %>">
            <a class="page-link" href="?page=<%= p %>&search=<%= search %>&job=<%= jobFilter %>"><%= p %></a>
          </li><% } %>
        </ul></nav>
      </div>
      <% } %>
    </div>
  </div>
</div>
<script>
$('.status-select').on('change', function() {
  const id = $(this).data('id'), status = $(this).val();
  $.ajax({ url: '/admin/applications/status', method: 'POST', contentType: 'application/json',
    data: JSON.stringify({ applicationid: id, status }),
    success: r => showToast(r.statusCode===200 ? 'Status updated!' : r.msg, r.statusCode===200?'success':'danger')
  });
});
</script>
