<!-- views/admin/job-list.ejs -->
<div class="admin-wrapper">
  <%- include('../partials/adminsidebar') %>
  <div class="admin-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h4 class="fw-bold mb-0"><i class="fas fa-briefcase me-2 text-primary"></i>Manage Jobs</h4>
      <a href="/admin/jobs/create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add Job</a>
    </div>

    <!-- Filters -->
    <form class="row g-2 mb-3" method="GET" action="/admin/jobs">
      <div class="col-md-5">
        <input type="text" name="search" class="form-control" placeholder="Search job title..." value="<%= search %>">
      </div>
      <div class="col-md-3">
        <select name="status" class="form-select">
          <option value="">All Status</option>
          <option value="0" <%= statusFilter==='0' ? 'selected':'' %>>Pending</option>
          <option value="1" <%= statusFilter==='1' ? 'selected':'' %>>Approved</option>
          <option value="2" <%= statusFilter==='2' ? 'selected':'' %>>Rejected</option>
        </select>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
      </div>
      <div class="col-md-2">
        <a href="/admin/jobs" class="btn btn-outline-secondary w-100">Reset</a>
      </div>
    </form>

    <div class="admin-table">
      <div class="table-responsive">
        <table class="table mb-0">
          <thead>
            <tr>
              <th>Job Title</th>
              <th>Category</th>
              <th>Posted By</th>
              <th>Applications</th>
              <th>Status</th>
              <th>Date</th>
              <th class="text-center">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% const apLabels = ['Pending','Approved','Rejected']; %>
            <% const apCls    = ['badge-pending','badge-approved','badge-rejected']; %>
            <% for (const j of jobs) { %>
            <tr id="row-<%= j.jobid %>">
              <td>
                <div class="fw-semibold"><%= j.jobtitle %></div>
                <div class="text-muted" style="font-size:.75rem">
                  <%= j.jobtype == 1 ? 'Full-time' : j.jobtype == 2 ? 'Part-time' : j.jobtype == 3 ? 'Contract' : 'Internship' %>
                </div>
              </td>
              <td class="text-muted small"><%= j.categoryname || '-' %></td>
              <td class="text-muted small"><%= j.postername || 'Admin' %></td>
              <td class="text-center"><span class="badge bg-light text-dark border fw-bold"><%= j.appcount %></span></td>
              <td>
                <span class="badge job-badge <%= apCls[j.approvalstatus||0] %>" id="status-<%= j.jobid %>">
                  <%= apLabels[j.approvalstatus||0] %>
                </span>
              </td>
              <td class="text-muted small"><%= moment(j.addeddate).format('DD MMM YYYY') %></td>
              <td class="text-center">
                <div class="d-flex gap-1 justify-content-center">
                  <!-- Approve / Reject (only if pending) -->
                  <% if (j.approvalstatus === 0) { %>
                    <button class="btn btn-sm btn-success" onclick="approveJob(<%= j.jobid %>,'approve')" title="Approve">
                      <i class="fas fa-check"></i>
                    </button>
                    <button class="btn btn-sm btn-danger" onclick="openReject(<%= j.jobid %>)" title="Reject">
                      <i class="fas fa-times"></i>
                    </button>
                  <% } else if (j.approvalstatus === 2) { %>
                    <button class="btn btn-sm btn-outline-success" onclick="approveJob(<%= j.jobid %>,'approve')" title="Re-approve">
                      <i class="fas fa-redo"></i>
                    </button>
                  <% } %>
                  <a href="/admin/jobs/<%= j.jobid %>/edit" class="btn btn-sm btn-outline-primary" title="Edit">
                    <i class="fas fa-edit"></i>
                  </a>
                  <a href="/admin/applications?job=<%= j.jobid %>" class="btn btn-sm btn-outline-info" title="Applications">
                    <i class="fas fa-users"></i>
                  </a>
                  <button class="btn btn-sm btn-outline-danger" onclick="deleteJob(<%= j.jobid %>)" title="Delete">
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
              </td>
            </tr>
            <% } %>
            <% if (!jobs.length) { %>
              <tr><td colspan="7" class="text-center py-5 text-muted">
                <i class="fas fa-briefcase fa-2x mb-2 d-block"></i>No jobs found.
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <% if (pagination.totalPages > 1) { %>
      <div class="p-3 border-top d-flex justify-content-between align-items-center">
        <span class="text-muted small">Showing page <%= pagination.page %> of <%= pagination.totalPages %> (<%= pagination.total %> total)</span>
        <nav>
          <ul class="pagination pagination-sm mb-0">
            <% for (let p = 1; p <= pagination.totalPages; p++) { %>
            <li class="page-item <%= p === pagination.page ? 'active' : '' %>">
              <a class="page-link" href="?page=<%= p %>&search=<%= search %>&status=<%= statusFilter %>"><%= p %></a>
            </li>
            <% } %>
          </ul>
        </nav>
      </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Reject Job</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <input type="hidden" id="rejectJobId">
        <label class="form-label fw-semibold">Reason for rejection <span class="text-danger">*</span></label>
        <textarea id="rejectReason" class="form-control" rows="3" placeholder="Explain why this job is being rejected..."></textarea>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-danger" onclick="submitReject()">Reject Job</button>
      </div>
    </div>
  </div>
</div>

<script>
function approveJob(jobid, action) {
  $.post('/admin/jobs/approve', JSON.stringify({ jobid, action }), function(r) {
    if (r.statusCode === 200) { showToast(r.msg); setTimeout(() => location.reload(), 800); }
    else showToast(r.msg, 'danger');
  }, 'json').fail(() => showToast('Network error', 'danger'));
}

// Override jQuery default content-type for this specific call
$(document).ready(function() {
  $(document).on('ajaxSend', function(event, xhr, settings) {
    if (settings.url === '/admin/jobs/approve') {
      settings.contentType = 'application/json';
    }
  });
});

function openReject(jobid) {
  document.getElementById('rejectJobId').value = jobid;
  document.getElementById('rejectReason').value = '';
  new bootstrap.Modal('#rejectModal').show();
}

function submitReject() {
  const jobid = document.getElementById('rejectJobId').value;
  const rejectionreason = document.getElementById('rejectReason').value.trim();
  if (!rejectionreason) { alert('Please enter a reason'); return; }
  $.ajax({
    url: '/admin/jobs/approve', method: 'POST',
    contentType: 'application/json',
    data: JSON.stringify({ jobid, action: 'reject', rejectionreason }),
    success: r => {
      bootstrap.Modal.getInstance('#rejectModal').hide();
      if (r.statusCode === 200) { showToast('Job rejected'); setTimeout(() => location.reload(), 800); }
      else showToast(r.msg, 'danger');
    }
  });
}

function deleteJob(id) {
  if (!confirm('Delete this job and all its applications?')) return;
  $.ajax({ url: '/admin/jobs/' + id + '/delete', method: 'DELETE',
    success: r => { if (r.statusCode === 200) { showToast('Deleted'); setTimeout(() => location.reload(), 800); }
      else showToast(r.msg, 'danger'); }
  });
}
</script>
