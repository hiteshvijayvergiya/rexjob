<!-- Privacy Policy Page -->
<section class="page-header bg-primary text-white py-5">
    <div class="container">
        <h1 class="text-center mb-3">Privacy Policy</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-white">Home</a></li>
                <li class="breadcrumb-item active text-white">Privacy Policy</li>
            </ol>
        </nav>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-9 mx-auto">
                <p class="text-muted mb-4"><strong>Effective Date:</strong> <%= new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                
                <div class="alert alert-info mb-4">
                    <i class="fas fa-shield-alt me-2"></i>
                    <strong>Your privacy is important to us.</strong> This Privacy Policy explains how <%= appName %> collects, uses, and protects your personal information.
                </div>

                <h2 class="fw-bold mb-3">1. Information We Collect</h2>
                
                <h4 class="fw-bold mb-3">1.1 Information You Provide</h4>
                <p class="mb-3">When you use <%= appName %>, you may provide us with:</p>
                <ul class="mb-4">
                    <li><strong>Account Information:</strong> Name, email address, phone number, password</li>
                    <li><strong>Profile Information:</strong> Resume, work experience, education, skills, preferences</li>
                    <li><strong>Job Application Data:</strong> Cover letters, portfolio links, references</li>
                    <li><strong>Payment Information:</strong> Billing address, payment method details (processed securely by third-party providers)</li>
                    <li><strong>Communications:</strong> Messages, feedback, support requests</li>
                </ul>

                <h4 class="fw-bold mb-3">1.2 Automatically Collected Information</h4>
                <p class="mb-3">We automatically collect certain information when you use our Platform:</p>
                <ul class="mb-4">
                    <li><strong>Device Information:</strong> IP address, browser type, operating system, device identifiers</li>
                    <li><strong>Usage Data:</strong> Pages visited, time spent, search queries, clicks, referring URLs</li>
                    <li><strong>Location Data:</strong> General location based on IP address</li>
                    <li><strong>Cookies and Tracking:</strong> Information collected through cookies and similar technologies</li>
                </ul>

                <h4 class="fw-bold mb-3">1.3 Information from Third Parties</h4>
                <p class="mb-4">
                    We may receive information about you from third parties such as social media platforms (if you choose 
                    to connect your account), background check providers (with your consent), or other recruitment platforms.
                </p>

                <h2 class="fw-bold mb-3">2. How We Use Your Information</h2>
                <p class="mb-3">We use your information for the following purposes:</p>
                
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="card h-100 border-primary">
                            <div class="card-body">
                                <h6 class="fw-bold text-primary mb-2"><i class="fas fa-briefcase me-2"></i>Job Matching</h6>
                                <p class="small mb-0">To match you with relevant job opportunities and recommend positions based on your profile.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100 border-success">
                            <div class="card-body">
                                <h6 class="fw-bold text-success mb-2"><i class="fas fa-user-check me-2"></i>Account Management</h6>
                                <p class="small mb-0">To create and manage your account, verify your identity, and provide customer support.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100 border-warning">
                            <div class="card-body">
                                <h6 class="fw-bold text-warning mb-2"><i class="fas fa-bell me-2"></i>Communications</h6>
                                <p class="small mb-0">To send job alerts, newsletters, and important updates about our services.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100 border-info">
                            <div class="card-body">
                                <h6 class="fw-bold text-info mb-2"><i class="fas fa-chart-line me-2"></i>Analytics</h6>
                                <p class="small mb-0">To analyze usage patterns and improve our Platform's functionality and user experience.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <ul class="mb-4">
                    <li>Process job applications and connect you with employers</li>
                    <li>Comply with legal obligations and protect our rights</li>
                    <li>Detect and prevent fraud, spam, and security threats</li>
                    <li>Conduct research and development to improve our services</li>
                    <li>Provide personalized content and advertisements (with your consent)</li>
                </ul>

                <h2 class="fw-bold mb-3">3. How We Share Your Information</h2>
                <p class="mb-3">We may share your information in the following circumstances:</p>

                <h4 class="fw-bold mb-3">3.1 With Employers</h4>
                <p class="mb-4">
                    When you apply for a job, we share your application materials (resume, cover letter) with the hiring 
                    company. You explicitly consent to this sharing when you click "Apply."
                </p>

                <h4 class="fw-bold mb-3">3.2 Service Providers</h4>
                <p class="mb-4">
                    We work with third-party service providers who help us operate our Platform, including:
                </p>
                <ul class="mb-4">
                    <li>Cloud storage providers (AWS S3)</li>
                    <li>Email service providers</li>
                    <li>Analytics providers</li>
                    <li>Payment processors</li>
                    <li>Customer support tools</li>
                </ul>

                <h4 class="fw-bold mb-3">3.3 Legal Requirements</h4>
                <p class="mb-4">
                    We may disclose your information if required by law, court order, or government request, or to:
                </p>
                <ul class="mb-4">
                    <li>Comply with legal processes</li>
                    <li>Enforce our Terms and Conditions</li>
                    <li>Protect our rights, property, or safety</li>
                    <li>Investigate fraud or security issues</li>
                </ul>

                <h4 class="fw-bold mb-3">3.4 Business Transfers</h4>
                <p class="mb-4">
                    If <%= appName %> is involved in a merger, acquisition, or sale of assets, your information may be 
                    transferred as part of that transaction.
                </p>

                <h4 class="fw-bold mb-3">3.5 With Your Consent</h4>
                <p class="mb-4">
                    We may share your information with other parties when you give us explicit consent to do so.
                </p>

                <h2 class="fw-bold mb-3">4. Data Retention</h2>
                <p class="mb-4">
                    We retain your personal information for as long as necessary to provide our services and comply with 
                    legal obligations. When you delete your account, we will delete or anonymize your information within 
                    30 days, except where we are required to retain it by law.
                </p>

                <h2 class="fw-bold mb-3">5. Your Rights and Choices</h2>
                <p class="mb-3">You have the following rights regarding your personal information:</p>

                <div class="table-responsive mb-4">
                    <table class="table table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Right</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>Access</strong></td>
                                <td>Request a copy of your personal information</td>
                            </tr>
                            <tr>
                                <td><strong>Correction</strong></td>
                                <td>Update or correct inaccurate information</td>
                            </tr>
                            <tr>
                                <td><strong>Deletion</strong></td>
                                <td>Request deletion of your personal information</td>
                            </tr>
                            <tr>
                                <td><strong>Opt-Out</strong></td>
                                <td>Unsubscribe from marketing emails and notifications</td>
                            </tr>
                            <tr>
                                <td><strong>Portability</strong></td>
                                <td>Receive your data in a portable format</td>
                            </tr>
                            <tr>
                                <td><strong>Object</strong></td>
                                <td>Object to certain processing of your information</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <p class="mb-4">
                    To exercise these rights, contact us at <a href="mailto:privacy@rexjobs.in">privacy@rexjobs.in</a> 
                    or visit your <a href="/account/profile">account settings</a>.
                </p>

                <h2 class="fw-bold mb-3">6. Security</h2>
                <p class="mb-4">
                    We implement industry-standard security measures to protect your information, including:
                </p>
                <ul class="mb-4">
                    <li>Encryption of data in transit and at rest (SSL/TLS)</li>
                    <li>Secure password hashing (bcrypt)</li>
                    <li>Regular security audits and vulnerability assessments</li>
                    <li>Access controls and authentication mechanisms</li>
                    <li>Secure cloud infrastructure</li>
                </ul>
                <p class="mb-4">
                    However, no method of transmission over the internet is 100% secure. We cannot guarantee absolute 
                    security of your information.
                </p>

                <h2 class="fw-bold mb-3">7. Cookies and Tracking Technologies</h2>
                <p class="mb-4">
                    We use cookies and similar technologies to enhance your experience. For detailed information about 
                    our use of cookies, please read our <a href="/cookie-policy">Cookie Policy</a>.
                </p>

                <h2 class="fw-bold mb-3">8. Children's Privacy</h2>
                <p class="mb-4">
                    <%= appName %> is not intended for users under 18 years of age. We do not knowingly collect personal 
                    information from children. If you believe we have collected information from a child, please contact us 
                    immediately.
                </p>

                <h2 class="fw-bold mb-3">9. International Data Transfers</h2>
                <p class="mb-4">
                    Your information may be transferred to and processed in countries other than your own. We ensure 
                    appropriate safeguards are in place to protect your information in accordance with this Privacy Policy.
                </p>

                <h2 class="fw-bold mb-3">10. Third-Party Links</h2>
                <p class="mb-4">
                    Our Platform may contain links to third-party websites. We are not responsible for the privacy 
                    practices of these external sites. We encourage you to review their privacy policies.
                </p>

                <h2 class="fw-bold mb-3">11. Changes to This Privacy Policy</h2>
                <p class="mb-4">
                    We may update this Privacy Policy from time to time. We will notify you of significant changes via 
                    email or Platform notification. Your continued use of <%= appName %> after changes indicates your 
                    acceptance of the updated policy.
                </p>

                <h2 class="fw-bold mb-3">12. Contact Us</h2>
                <p class="mb-3">If you have questions or concerns about this Privacy Policy, please contact us:</p>
                
                <div class="card bg-light mb-4">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Privacy Team</h5>
                        <ul class="list-unstyled mb-0">
                            <li class="mb-2"><i class="fas fa-envelope text-primary me-2"></i> <strong>Email:</strong> privacy@rexjobs.in</li>
                            <li class="mb-2"><i class="fas fa-phone text-primary me-2"></i> <strong>Phone:</strong> +91 1234567890</li>
                            <li class="mb-2"><i class="fas fa-map-marker-alt text-primary me-2"></i> <strong>Address:</strong> 123 Business Street, City, India</li>
                            <li><i class="fas fa-globe text-primary me-2"></i> <strong>Contact Form:</strong> <a href="/contact">Click here</a></li>
                        </ul>
                    </div>
                </div>

                <div class="alert alert-success">
                    <h5 class="fw-bold mb-2"><i class="fas fa-info-circle me-2"></i>Your Privacy Matters</h5>
                    <p class="mb-0">
                        We are committed to protecting your privacy and handling your personal information responsibly. 
                        For more information about your rights, visit our 
                        <a href="/do-not-sell" class="alert-link">Do Not Sell My Personal Information</a> page.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
