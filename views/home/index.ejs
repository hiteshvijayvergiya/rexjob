<!-- Hero Section -->
<section class="hero bg-gradient py-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 text-white">
                <h1 class="display-4 fw-bold mb-4">Find Your Dream Job</h1>
                <p class="lead mb-4">
                    Connect with top companies and explore thousands of job opportunities across various industries.
                </p>
                <a href="/career" class="btn btn-light btn-lg px-5">
                    <i class="fas fa-search me-2"></i> Browse Jobs
                </a>
            </div>
            <div class="col-lg-6">
                <div class="card border-0 shadow-lg">
                    <div class="card-body p-4">
                        <h4 class="card-title mb-4">Quick Job Search</h4>
                        <form action="/career" method="GET">
                            <div class="mb-3">
                                <input type="text" class="form-control form-control-lg" name="search" 
                                       placeholder="Job title, keywords...">
                            </div>
                            <div class="mb-3">
                                <select class="form-select form-select-lg" name="category">
                                    <option value="0">All Categories</option>
                                    <% categories.forEach(function(cat) { %>
                                        <option value="<%= cat.requirementtypeid %>">
                                            <%= cat.requirementtypename %> (<%= cat.jobcount %>)
                                        </option>
                                    <% }); %>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary btn-lg w-100">
                                <i class="fas fa-search me-2"></i> Search Jobs
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Job Categories -->
<section class="categories py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Browse by Category</h2>
            <p class="text-muted">Explore jobs across different industries</p>
        </div>
        
        <div class="row g-4">
            <% categories.slice(0, 6).forEach(function(category) { %>
                <div class="col-md-4 col-lg-2">
                    <a href="/category/<%= category.requirementtypename.toLowerCase().replace(/ /g, '-') %>" 
                       class="text-decoration-none">
                        <div class="card h-100 text-center hover-shadow">
                            <div class="card-body">
                                <div class="icon-circle bg-primary bg-opacity-10 text-primary mb-3 mx-auto" 
                                     style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 50%;">
                                    <i class="fas fa-briefcase fa-2x"></i>
                                </div>
                                <h6 class="card-title mb-2"><%= category.requirementtypename %></h6>
                                <p class="text-muted small mb-0"><%= category.jobcount %> Jobs</p>
                            </div>
                        </div>
                    </a>
                </div>
            <% }); %>
        </div>
        
        <div class="text-center mt-4">
            <a href="/career" class="btn btn-outline-primary">View All Categories</a>
        </div>
    </div>
</section>

<!-- Latest Jobs -->
<section class="latest-jobs py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">Latest Job Openings</h2>
                <p class="text-muted mb-0">Fresh opportunities just for you</p>
            </div>
            <a href="/career" class="btn btn-primary">View All Jobs</a>
        </div>
        
        <div class="row g-4">
            <% if (jobs && jobs.length > 0) { %>
                <% jobs.forEach(function(job) { %>
                    <div class="col-lg-6">
                        <div class="card job-card h-100 hover-shadow">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div class="flex-grow-1">
                                        <h5 class="card-title mb-2">
                                            <a href="/job/<%= job.requirementid %>" class="text-dark text-decoration-none">
                                                <%= job.requirementname %>
                                            </a>
                                        </h5>
                                        <p class="text-muted mb-2">
                                            <i class="fas fa-building me-2"></i>Company Name
                                        </p>
                                    </div>
                                    <% if (job.requirementpriorityname === 'Urgent') { %>
                                        <span class="badge bg-danger">Urgent</span>
                                    <% } else if (job.requirementpriorityname === 'High') { %>
                                        <span class="badge bg-warning">High</span>
                                    <% } %>
                                </div>
                                
                                <div class="job-meta mb-3">
                                    <span class="badge bg-light text-dark me-2">
                                        <i class="fas fa-map-marker-alt me-1"></i> <%= job.cityname %>
                                    </span>
                                    <span class="badge bg-light text-dark me-2">
                                        <i class="fas fa-briefcase me-1"></i> <%= job.requirementpositionname %>
                                    </span>
                                    <% if (job.expstart || job.expend) { %>
                                        <span class="badge bg-light text-dark">
                                            <i class="fas fa-clock me-1"></i> 
                                            <%= job.expstart || 0 %>-<%= job.expend || 0 %> years
                                        </span>
                                    <% } %>
                                </div>
                                
                                <p class="card-text text-muted small mb-3">
                                    <%= job.requirementdescription ? job.requirementdescription.substring(0, 150) + '...' : 'No description available' %>
                                </p>
                                
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="text-muted small">
                                        <i class="fas fa-calendar-alt me-1"></i>
                                        Posted <%= moment(job.addeddate).fromNow() %>
                                    </div>
                                    <a href="/job/<%= job.requirementid %>" class="btn btn-sm btn-outline-primary">
                                        View Details <i class="fas fa-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="col-12">
                    <div class="alert alert-info text-center">
                        <i class="fas fa-info-circle me-2"></i>
                        No jobs available at the moment. Check back later!
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</section>

<!-- Why Choose Us -->
<section class="features py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Why Choose <%= appName %>?</h2>
            <p class="text-muted">Your trusted job search partner</p>
        </div>
        
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card border-0 text-center h-100">
                    <div class="card-body p-4">
                        <div class="icon-circle bg-primary bg-opacity-10 text-primary mb-3 mx-auto" 
                             style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; border-radius: 50%;">
                            <i class="fas fa-rocket fa-3x"></i>
                        </div>
                        <h5 class="card-title mb-3">Fast & Easy</h5>
                        <p class="card-text text-muted">
                            Quick application process with instant notifications
                        </p>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card border-0 text-center h-100">
                    <div class="card-body p-4">
                        <div class="icon-circle bg-success bg-opacity-10 text-success mb-3 mx-auto" 
                             style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; border-radius: 50%;">
                            <i class="fas fa-shield-alt fa-3x"></i>
                        </div>
                        <h5 class="card-title mb-3">Verified Companies</h5>
                        <p class="card-text text-muted">
                            Connect with trusted and verified employers only
                        </p>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card border-0 text-center h-100">
                    <div class="card-body p-4">
                        <div class="icon-circle bg-warning bg-opacity-10 text-warning mb-3 mx-auto" 
                             style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; border-radius: 50%;">
                            <i class="fas fa-users fa-3x"></i>
                        </div>
                        <h5 class="card-title mb-3">Wide Network</h5>
                        <p class="card-text text-muted">
                            Access to thousands of job opportunities nationwide
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta py-5 bg-primary text-white">
    <div class="container text-center">
        <h2 class="fw-bold mb-3">Ready to Start Your Career Journey?</h2>
        <p class="lead mb-4">Join thousands of job seekers who found their dream jobs with us</p>
        <div class="d-flex justify-content-center gap-3">
            <a href="/career" class="btn btn-light btn-lg px-5">Browse Jobs</a>
            <a href="/account/signup" class="btn btn-outline-light btn-lg px-5">Sign Up Free</a>
        </div>
    </div>
</section>

<style>
.hover-shadow {
    transition: all 0.3s ease;
}

.hover-shadow:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
}

.job-card {
    border: 1px solid #e0e0e0;
    transition: all 0.3s ease;
}

.job-card:hover {
    border-color: #667eea;
}
</style>
