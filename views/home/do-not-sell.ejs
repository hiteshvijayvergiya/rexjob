<!-- Do Not Sell My Personal Information Page -->
<section class="page-header bg-primary text-white py-5">
    <div class="container">
        <h1 class="text-center mb-3">Do Not Sell My Personal Information</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-white">Home</a></li>
                <li class="breadcrumb-item active text-white">Do Not Sell</li>
            </ol>
        </nav>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <div class="content-box">
                    <div class="alert alert-info mb-4">
                        <i class="fas fa-shield-alt me-2"></i>
                        <strong>Your Privacy Matters:</strong> <%= appName %> respects your privacy rights and is committed to protecting your personal information.
                    </div>

                    <h2 class="fw-bold mb-3">Your Right to Opt-Out</h2>
                    <p class="mb-4">
                        Under various privacy laws including the California Consumer Privacy Act (CCPA), you have the right to 
                        opt-out of the sale of your personal information. This page explains how <%= appName %> handles your 
                        data and how you can exercise your rights.
                    </p>

                    <h2 class="fw-bold mb-3">Our Commitment</h2>
                    <p class="mb-4">
                        <strong><%= appName %> does NOT sell your personal information.</strong> We do not and will not sell, 
                        rent, or share your personal information with third parties for their marketing purposes without your 
                        explicit consent.
                    </p>

                    <h2 class="fw-bold mb-3">How We Use Your Information</h2>
                    <p class="mb-3">We collect and use your personal information only for the following purposes:</p>
                    <ul class="mb-4">
                        <li>To provide and improve our job portal services</li>
                        <li>To match you with relevant job opportunities</li>
                        <li>To communicate with you about your account and applications</li>
                        <li>To send you job alerts and newsletters (with your consent)</li>
                        <li>To comply with legal obligations</li>
                        <li>To protect our services and users</li>
                    </ul>

                    <h2 class="fw-bold mb-3">Information We Share</h2>
                    <p class="mb-3">We may share your information only in these limited circumstances:</p>
                    
                    <div class="card mb-4">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">1. With Your Consent</h5>
                            <p class="card-text mb-0">
                                When you apply for a job, we share your resume and application details with the hiring company 
                                (with your explicit consent when you click "Apply").
                            </p>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">2. Service Providers</h5>
                            <p class="card-text mb-0">
                                We work with trusted service providers (e.g., email services, cloud storage) who help us operate 
                                our platform. These providers are contractually obligated to keep your information secure and 
                                confidential.
                            </p>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">3. Legal Requirements</h5>
                            <p class="card-text mb-0">
                                We may disclose your information when required by law, court order, or to protect our rights 
                                and safety.
                            </p>
                        </div>
                    </div>

                    <h2 class="fw-bold mb-3">Your Privacy Rights</h2>
                    <p class="mb-3">You have the following rights regarding your personal information:</p>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="card h-100 border-primary">
                                <div class="card-body">
                                    <h6 class="fw-bold text-primary mb-2"><i class="fas fa-eye me-2"></i>Right to Know</h6>
                                    <p class="small mb-0">Request details about the personal information we collect and how we use it.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card h-100 border-success">
                                <div class="card-body">
                                    <h6 class="fw-bold text-success mb-2"><i class="fas fa-trash me-2"></i>Right to Delete</h6>
                                    <p class="small mb-0">Request deletion of your personal information from our systems.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card h-100 border-warning">
                                <div class="card-body">
                                    <h6 class="fw-bold text-warning mb-2"><i class="fas fa-edit me-2"></i>Right to Correct</h6>
                                    <p class="small mb-0">Update or correct inaccurate personal information.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card h-100 border-info">
                                <div class="card-body">
                                    <h6 class="fw-bold text-info mb-2"><i class="fas fa-ban me-2"></i>Right to Opt-Out</h6>
                                    <p class="small mb-0">Opt-out of the sale of your personal information (not applicable as we don't sell data).</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h2 class="fw-bold mb-3">How to Exercise Your Rights</h2>
                    <p class="mb-4">
                        To exercise any of your privacy rights, please use one of the following methods:
                    </p>

                    <div class="card bg-light mb-4">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3">Contact Us:</h5>
                            <ul class="list-unstyled mb-0">
                                <li class="mb-2">
                                    <i class="fas fa-envelope text-primary me-2"></i>
                                    <strong>Email:</strong> privacy@rexjobs.in
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-phone text-primary me-2"></i>
                                    <strong>Phone:</strong> +91 1234567890
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-globe text-primary me-2"></i>
                                    <strong>Online Form:</strong> <a href="/contact">Submit a request</a>
                                </li>
                                <li>
                                    <i class="fas fa-user text-primary me-2"></i>
                                    <strong>Account Settings:</strong> Update preferences in your <a href="/account/profile">profile</a>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <h2 class="fw-bold mb-3">Verification Process</h2>
                    <p class="mb-4">
                        To protect your privacy and security, we will verify your identity before processing your request. 
                        You may be asked to provide:
                    </p>
                    <ul class="mb-4">
                        <li>Your registered email address</li>
                        <li>Account username or ID</li>
                        <li>Additional verification information</li>
                    </ul>

                    <h2 class="fw-bold mb-3">Response Time</h2>
                    <p class="mb-4">
                        We will respond to your request within <strong>45 days</strong> of receipt. If we need more time, 
                        we will notify you and provide an explanation.
                    </p>

                    <h2 class="fw-bold mb-3">No Discrimination</h2>
                    <p class="mb-4">
                        You will not receive discriminatory treatment for exercising your privacy rights. We will not:
                    </p>
                    <ul class="mb-4">
                        <li>Deny you services</li>
                        <li>Charge different prices or rates</li>
                        <li>Provide different quality of service</li>
                    </ul>

                    <h2 class="fw-bold mb-3">Children's Privacy</h2>
                    <p class="mb-4">
                        <%= appName %> does not knowingly collect personal information from children under 18 years of age. 
                        If you believe we have collected information from a child, please contact us immediately.
                    </p>

                    <h2 class="fw-bold mb-3">Updates to This Notice</h2>
                    <p class="mb-4">
                        We may update this notice from time to time. Any changes will be posted on this page with an updated date.
                    </p>

                    <div class="alert alert-success">
                        <h5 class="fw-bold mb-2"><i class="fas fa-check-circle me-2"></i>Questions?</h5>
                        <p class="mb-0">
                            For more information about how we protect your privacy, please read our 
                            <a href="/privacy-policy" class="alert-link">Privacy Policy</a> or 
                            <a href="/contact" class="alert-link">contact us</a>.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
