<!-- Career/Job Listings Page -->
<section class="page-header bg-primary text-white py-4">
    <div class="container">
        <h1 class="text-center mb-3">Find Your Dream Job</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-white">Home</a></li>
                <li class="breadcrumb-item active text-white">Career</li>
            </ol>
        </nav>
    </div>
</section>

<section class="py-4">
    <div class="container">
        <!-- Search & Filter -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <form action="/career" method="GET" id="jobSearchForm">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <input type="text" class="form-control" name="search" placeholder="Job title, keywords..." 
                                   value="<%= filters.search %>">
                        </div>
                        <div class="col-md-3">
                            <select class="form-select" name="category" id="categoryFilter">
                                <option value="0">All Categories</option>
                                <% categories.forEach(cat => { %>
                                    <option value="<%= cat.value %>" <%= filters.category == cat.value ? 'selected' : '' %>>
                                        <%= cat.text %>
                                    </option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select" name="location">
                                <option value="0">All Locations</option>
                                <% locations.forEach(loc => { %>
                                    <option value="<%= loc.value %>" <%= filters.location == loc.value ? 'selected' : '' %>>
                                        <%= loc.text %>
                                    </option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-search"></i> Search
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="row">
            <!-- Filters Sidebar -->
            <div class="col-lg-3 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Filters</h5>
                    </div>
                    <div class="card-body">
                        <form action="/career" method="GET">
                            <!-- Keep search term -->
                            <input type="hidden" name="search" value="<%= filters.search %>">
                            
                            <!-- Job Type -->
                            <h6 class="fw-bold mb-3">Job Type</h6>
                            <div class="mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="jobtype" value="0" 
                                           <%= filters.jobtype == 0 ? 'checked' : '' %>>
                                    <label class="form-check-label">All Types</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="jobtype" value="1" 
                                           <%= filters.jobtype == 1 ? 'checked' : '' %>>
                                    <label class="form-check-label">Full Time</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="jobtype" value="2" 
                                           <%= filters.jobtype == 2 ? 'checked' : '' %>>
                                    <label class="form-check-label">Part Time</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="jobtype" value="3" 
                                           <%= filters.jobtype == 3 ? 'checked' : '' %>>
                                    <label class="form-check-label">Contract</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="jobtype" value="4" 
                                           <%= filters.jobtype == 4 ? 'checked' : '' %>>
                                    <label class="form-check-label">Internship</label>
                                </div>
                            </div>
                            
                            <button type="submit" class="btn btn-primary w-100 mb-2">Apply Filters</button>
                            <a href="/career" class="btn btn-outline-secondary w-100">Clear Filters</a>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Job Listings -->
            <div class="col-lg-9">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0"><%= pagination.total %> Jobs Found</h5>
                    <span class="text-muted">Page <%= pagination.page %> of <%= pagination.totalPages %></span>
                </div>

                <% if (jobs && jobs.length > 0) { %>
                    <% jobs.forEach(job => { %>
                        <div class="card shadow-sm mb-3 job-card">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-8">
                                        <h5 class="card-title mb-2">
                                            <a href="/job/<%= job.requirementid %>" class="text-dark text-decoration-none">
                                                <%= job.requirementname %>
                                            </a>
                                        </h5>
                                        <p class="text-muted mb-2">
                                            <i class="fas fa-building me-2"></i>Company Name
                                        </p>
                                        <div class="mb-3">
                                            <span class="badge bg-light text-dark me-2">
                                                <i class="fas fa-map-marker-alt me-1"></i><%= job.cityname %>
                                            </span>
                                            <span class="badge bg-light text-dark me-2">
                                                <i class="fas fa-briefcase me-1"></i><%= job.requirementpositionname %>
                                            </span>
                                            <% if (job.expstart || job.expend) { %>
                                                <span class="badge bg-light text-dark">
                                                    <i class="fas fa-clock me-1"></i><%= job.expstart || 0 %>-<%= job.expend || 0 %> years
                                                </span>
                                            <% } %>
                                        </div>
                                        <p class="card-text text-muted small">
                                            <%= job.requirementdescription ? job.requirementdescription.substring(0, 120) + '...' : '' %>
                                        </p>
                                    </div>
                                    <div class="col-md-4 text-md-end d-flex flex-column justify-content-between">
                                        <div>
                                            <% if (job.requirementpriorityname === 'Urgent') { %>
                                                <span class="badge bg-danger mb-2">Urgent</span>
                                            <% } %>
                                            <p class="text-muted small mb-2">
                                                <i class="far fa-calendar-alt me-1"></i>
                                                Posted <%= moment(job.addeddate).fromNow() %>
                                            </p>
                                        </div>
                                        <a href="/job/<%= job.requirementid %>" class="btn btn-primary">
                                            View Details <i class="fas fa-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>

                    <!-- Pagination -->
                    <% if (pagination.totalPages > 1) { %>
                        <nav aria-label="Job listings pagination">
                            <ul class="pagination justify-content-center">
                                <li class="page-item <%= pagination.page === 1 ? 'disabled' : '' %>">
                                    <a class="page-link" href="/career?page=<%= pagination.page - 1 %>&search=<%= filters.search %>&category=<%= filters.category %>&location=<%= filters.location %>&jobtype=<%= filters.jobtype %>">
                                        Previous
                                    </a>
                                </li>
                                
                                <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                                    <% if (i === 1 || i === pagination.totalPages || (i >= pagination.page - 2 && i <= pagination.page + 2)) { %>
                                        <li class="page-item <%= pagination.page === i ? 'active' : '' %>">
                                            <a class="page-link" href="/career?page=<%= i %>&search=<%= filters.search %>&category=<%= filters.category %>&location=<%= filters.location %>&jobtype=<%= filters.jobtype %>">
                                                <%= i %>
                                            </a>
                                        </li>
                                    <% } else if (i === pagination.page - 3 || i === pagination.page + 3) { %>
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    <% } %>
                                <% } %>
                                
                                <li class="page-item <%= pagination.page === pagination.totalPages ? 'disabled' : '' %>">
                                    <a class="page-link" href="/career?page=<%= pagination.page + 1 %>&search=<%= filters.search %>&category=<%= filters.category %>&location=<%= filters.location %>&jobtype=<%= filters.jobtype %>">
                                        Next
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    <% } %>

                <% } else { %>
                    <div class="card shadow-sm">
                        <div class="card-body text-center py-5">
                            <i class="fas fa-search fa-3x text-muted mb-3"></i>
                            <h4>No Jobs Found</h4>
                            <p class="text-muted">Try adjusting your search filters or check back later for new opportunities.</p>
                            <a href="/career" class="btn btn-primary">Clear Filters</a>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<style>
.job-card {
    transition: all 0.3s ease;
}
.job-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.1) !important;
}
</style>
