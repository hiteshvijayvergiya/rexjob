@{
    ViewBag.Title = "Find Your Dream Job - RexJobs | Top Job Portal in India";
    ViewBag.MetaDescription = "Discover thousands of job opportunities across India. Search jobs by location, skills, experience. Apply now to top companies hiring on RexJobs - India's leading job portal.";
    ViewBag.MetaKeywords = "jobs, careers, employment, job search, job portal, hiring, vacancies, job openings, India jobs, career opportunities";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Hero Banner Section -->
<section class="hero-banner">
    <div class="hero-overlay"></div>
    <div class="container">
        <div class="row align-items-center min-vh-80">
            <div class="col-lg-8 mx-auto text-center hero-content">
                <h1 class="hero-title animate-fade-up">
                    Find Your <span class="text-gradient">Dream Career</span><br>
                    Start Your Journey Today
                </h1>
                <p class="hero-subtitle animate-fade-up-delay">
                    Connect with 50,000+ companies and discover unlimited opportunities across India
                </p>
                
                <!-- Main Search Box -->
                <div class="search-box-wrapper animate-fade-up-delay-2">
                    <form action="/Home/Career" method="get" class="job-search-form">
                        <div class="search-box">
                            <div class="search-input-group">
                                <i class="fas fa-search search-icon"></i>
                                <input type="text" name="s" class="form-control search-input" 
                                       placeholder="Job title, keywords, or company" autocomplete="off">
                            </div>
                            <div class="search-divider"></div>
                            <div class="search-input-group">
                                <i class="fas fa-map-marker-alt search-icon"></i>
                                <input type="text" name="location" class="form-control search-input" 
                                       placeholder="City or state" autocomplete="off">
                            </div>
                            <button type="submit" class="btn btn-search">
                                <i class="fas fa-search me-2"></i>Search Jobs
                            </button>
                        </div>
                    </form>
                    
                    <!-- Popular Searches -->
                    <div class="popular-searches">
                        <span class="popular-label">Trending:</span>
                        <a href="/Home/Career?s=software+developer" class="popular-tag">Software Developer</a>
                        <a href="/Home/Career?s=data+analyst" class="popular-tag">Data Analyst</a>
                        <a href="/Home/Career?s=digital+marketing" class="popular-tag">Digital Marketing</a>
                        <a href="/Home/Career?s=sales+manager" class="popular-tag">Sales Manager</a>
                    </div>
                </div>
                
                <!-- Quick Stats -->
                <div class="hero-stats animate-fade-up-delay-3">
                    <div class="stat-item">
                        <h3 class="stat-number"><span class="counter">50000</span>+</h3>
                        <p class="stat-label">Active Jobs</p>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item">
                        <h3 class="stat-number"><span class="counter">15000</span>+</h3>
                        <p class="stat-label">Companies</p>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item">
                        <h3 class="stat-number"><span class="counter">1000000</span>+</h3>
                        <p class="stat-label">Job Seekers</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Animated Background Elements -->
    <div class="hero-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
    </div>
</section>

<!-- Categories Section -->
<section class="categories-section py-5">
    <div class="container">
        <div class="section-header text-center mb-5">
            <h2 class="section-title">Browse Jobs by <span class="text-gradient">Category</span></h2>
            <p class="section-subtitle">Explore opportunities in your field of expertise</p>
        </div>
        
        <div class="row g-4">
            @if(ViewBag.CategoryList != null)
            {
                foreach (var category in ViewBag.CategoryList)
                {
                    <div class="col-md-6 col-lg-3">
                        <a href="/Candidate/Category?i=@category.Value" class="category-card">
                            <div class="category-icon">
                                <i class="fas fa-briefcase"></i>
                            </div>
                            <h5 class="category-name">@category.Text</h5>
                            <p class="category-count">@category.JobCount+ Jobs Available</p>
                            <div class="category-arrow">
                                <i class="fas fa-arrow-right"></i>
                            </div>
                        </a>
                    </div>
                }
            }
            else
            {
                <!-- Fallback Static Categories -->
                <div class="col-md-6 col-lg-3">
                    <a href="/Candidate/Category?i=it-software" class="category-card">
                        <div class="category-icon bg-blue">
                            <i class="fas fa-laptop-code"></i>
                        </div>
                        <h5 class="category-name">IT & Software</h5>
                        <p class="category-count">25,000+ Jobs</p>
                        <div class="category-arrow"><i class="fas fa-arrow-right"></i></div>
                    </a>
                </div>
                
                <div class="col-md-6 col-lg-3">
                    <a href="/Candidate/Category?i=sales-marketing" class="category-card">
                        <div class="category-icon bg-green">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <h5 class="category-name">Sales & Marketing</h5>
                        <p class="category-count">18,000+ Jobs</p>
                        <div class="category-arrow"><i class="fas fa-arrow-right"></i></div>
                    </a>
                </div>
                
                <div class="col-md-6 col-lg-3">
                    <a href="/Candidate/Category?i=finance" class="category-card">
                        <div class="category-icon bg-purple">
                            <i class="fas fa-coins"></i>
                        </div>
                        <h5 class="category-name">Finance & Banking</h5>
                        <p class="category-count">12,000+ Jobs</p>
                        <div class="category-arrow"><i class="fas fa-arrow-right"></i></div>
                    </a>
                </div>
                
                <div class="col-md-6 col-lg-3">
                    <a href="/Candidate/Category?i=healthcare" class="category-card">
                        <div class="category-icon bg-red">
                            <i class="fas fa-heartbeat"></i>
                        </div>
                        <h5 class="category-name">Healthcare</h5>
                        <p class="category-count">8,000+ Jobs</p>
                        <div class="category-arrow"><i class="fas fa-arrow-right"></i></div>
                    </a>
                </div>
                
                <div class="col-md-6 col-lg-3">
                    <a href="/Candidate/Category?i=engineering" class="category-card">
                        <div class="category-icon bg-orange">
                            <i class="fas fa-cogs"></i>
                        </div>
                        <h5 class="category-name">Engineering</h5>
                        <p class="category-count">15,000+ Jobs</p>
                        <div class="category-arrow"><i class="fas fa-arrow-right"></i></div>
                    </a>
                </div>
                
                <div class="col-md-6 col-lg-3">
                    <a href="/Candidate/Category?i=education" class="category-card">
                        <div class="category-icon bg-teal">
                            <i class="fas fa-graduation-cap"></i>
                        </div>
                        <h5 class="category-name">Education</h5>
                        <p class="category-count">6,000+ Jobs</p>
                        <div class="category-arrow"><i class="fas fa-arrow-right"></i></div>
                    </a>
                </div>
                
                <div class="col-md-6 col-lg-3">
                    <a href="/Candidate/Category?i=design" class="category-card">
                        <div class="category-icon bg-pink">
                            <i class="fas fa-palette"></i>
                        </div>
                        <h5 class="category-name">Design & Creative</h5>
                        <p class="category-count">5,000+ Jobs</p>
                        <div class="category-arrow"><i class="fas fa-arrow-right"></i></div>
                    </a>
                </div>
                
                <div class="col-md-6 col-lg-3">
                    <a href="/Candidate/Category" class="category-card view-all-card">
                        <div class="category-icon bg-dark">
                            <i class="fas fa-th"></i>
                        </div>
                        <h5 class="category-name">View All Categories</h5>
                        <p class="category-count">50+ Categories</p>
                        <div class="category-arrow"><i class="fas fa-arrow-right"></i></div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<!-- Featured Jobs Section -->
<section class="featured-jobs-section py-5 bg-light">
    <div class="container">
        <div class="section-header text-center mb-5">
            <h2 class="section-title">Latest <span class="text-gradient">Job Openings</span></h2>
            <p class="section-subtitle">Fresh opportunities updated daily</p>
        </div>
        
        <div class="row g-4">
            @if(Model.requirementList != null && Model.requirementList.Any())
            {
                foreach(var job in Model.requirementList.Take(6))
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="job-card">
                            <div class="job-card-header">
                                <div class="company-logo">
                                    <i class="fas fa-building"></i>
                                </div>
                                <div class="job-badge">
                                    <i class="fas fa-clock me-1"></i>@job.AddedDateDisplay
                                </div>
                            </div>
                            
                            <div class="job-card-body">
                                <h5 class="job-title">@job.RequirementName</h5>
                                <p class="company-name">
                                    <i class="fas fa-building me-2"></i>@job.RequirementTypeName
                                </p>
                                
                                <div class="job-meta">
                                    <span class="meta-item">
                                        <i class="fas fa-map-marker-alt"></i>@job.CityName
                                    </span>
                                    <span class="meta-item">
                                        <i class="fas fa-briefcase"></i>@job.ExpStart-@job.ExpEnd years
                                    </span>
                                    @if(job.SalaryStart > 0)
                                    {
                                        <span class="meta-item">
                                            <i class="fas fa-rupee-sign"></i>@job.SalaryStart - @job.SalaryEnd LPA
                                        </span>
                                    }
                                </div>
                                
                                @if(!string.IsNullOrEmpty(job.RequirementDescription))
                                {
                                    <p class="job-description">
                                        @(job.RequirementDescription.Length > 100 ? job.RequirementDescription.Substring(0, 100) + "..." : job.RequirementDescription)
                                    </p>
                                }
                            </div>
                            
                            <div class="job-card-footer">
                                <a href="/Candidate/Index?i=@job.RequirementId" class="btn btn-apply">
                                    Apply Now <i class="fas fa-arrow-right ms-2"></i>
                                </a>
                                <button class="btn btn-bookmark">
                                    <i class="far fa-bookmark"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
        
        <div class="text-center mt-5">
            <a href="/Home/Career" class="btn btn-primary btn-lg">
                View All Jobs <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</section>

<!-- How It Works Section -->
<section class="how-it-works-section py-5">
    <div class="container">
        <div class="section-header text-center mb-5">
            <h2 class="section-title">How <span class="text-gradient">RexJobs Works</span></h2>
            <p class="section-subtitle">Your journey to the perfect job in 3 simple steps</p>
        </div>
        
        <div class="row g-5">
            <div class="col-md-4">
                <div class="how-step">
                    <div class="step-number">1</div>
                    <div class="step-icon">
                        <i class="fas fa-search"></i>
                    </div>
                    <h4 class="step-title">Search Jobs</h4>
                    <p class="step-description">
                        Browse thousands of jobs across multiple categories and locations. Use filters to find exactly what you're looking for.
                    </p>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="how-step">
                    <div class="step-number">2</div>
                    <div class="step-icon">
                        <i class="fas fa-file-upload"></i>
                    </div>
                    <h4 class="step-title">Apply with Resume</h4>
                    <p class="step-description">
                        Upload your resume and apply to multiple jobs with a single click. Track all your applications in one place.
                    </p>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="how-step">
                    <div class="step-number">3</div>
                    <div class="step-icon">
                        <i class="fas fa-handshake"></i>
                    </div>
                    <h4 class="step-title">Get Hired</h4>
                    <p class="step-description">
                        Connect with recruiters, attend interviews, and land your dream job. We'll be with you every step of the way.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Companies Section -->
<section class="companies-section py-5 bg-light">
    <div class="container">
        <div class="section-header text-center mb-5">
            <h2 class="section-title">Trusted by <span class="text-gradient">Top Companies</span></h2>
            <p class="section-subtitle">Join professionals working at India's leading organizations</p>
