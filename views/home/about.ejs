<!-- About Page -->
<section class="page-header bg-primary text-white py-5">
    <div class="container">
        <h1 class="text-center mb-3">About Us</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-white">Home</a></li>
                <li class="breadcrumb-item active text-white">About</li>
            </ol>
        </nav>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row align-items-center mb-5">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <img src="/images/about-img.jpg" alt="About" class="img-fluid rounded shadow" onerror="this.src='https://via.placeholder.com/600x400/667eea/ffffff?text=About+Us'">
            </div>
            <div class="col-lg-6">
                <h2 class="fw-bold mb-4">Welcome to <%= appName %></h2>
                <p class="mb-3">
                    <%= appName %> is your premier destination for finding the perfect job or the ideal candidate. 
                    We connect talented professionals with leading companies across various industries.
                </p>
                <p class="mb-4">
                    With years of experience in recruitment, we understand the challenges faced by both job seekers 
                    and employers. Our platform simplifies the hiring process with advanced features and personalized support.
                </p>
                <div class="row g-3">
                    <div class="col-6">
                        <div class="text-center p-3 bg-light rounded">
                            <h3 class="text-primary fw-bold mb-0">1000+</h3>
                            <p class="text-muted small mb-0">Active Jobs</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="text-center p-3 bg-light rounded">
                            <h3 class="text-primary fw-bold mb-0">500+</h3>
                            <p class="text-muted small mb-0">Companies</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <i class="fas fa-bullseye fa-3x text-primary mb-3"></i>
                        <h3 class="fw-bold mb-3">Our Mission</h3>
                        <p class="mb-0">
                            To empower job seekers and employers with innovative tools and personalized support, 
                            creating meaningful connections that drive career growth and business success.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <i class="fas fa-eye fa-3x text-success mb-3"></i>
                        <h3 class="fw-bold mb-3">Our Vision</h3>
                        <p class="mb-0">
                            To become the most trusted job portal globally, recognized for excellence, innovation, 
                            and our commitment to helping individuals achieve their career aspirations.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Why Choose Us?</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4 text-center">
                <i class="fas fa-shield-alt fa-3x text-primary mb-3"></i>
                <h5 class="fw-bold mb-3">Verified Companies</h5>
                <p class="text-muted">All employers are verified for your safety</p>
            </div>
            <div class="col-md-4 text-center">
                <i class="fas fa-search fa-3x text-success mb-3"></i>
                <h5 class="fw-bold mb-3">Smart Search</h5>
                <p class="text-muted">Advanced filters to find the perfect match</p>
            </div>
            <div class="col-md-4 text-center">
                <i class="fas fa-headset fa-3x text-warning mb-3"></i>
                <h5 class="fw-bold mb-3">24/7 Support</h5>
                <p class="text-muted">We're here to help anytime you need</p>
            </div>
        </div>
    </div>
</section>
