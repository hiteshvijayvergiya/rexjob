<!-- Cookie Policy Page -->
<section class="page-header bg-primary text-white py-5">
    <div class="container">
        <h1 class="text-center mb-3">Cookie Policy</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-white">Home</a></li>
                <li class="breadcrumb-item active text-white">Cookie Policy</li>
            </ol>
        </nav>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <div class="content-box">
                    <p class="text-muted mb-4"><strong>Last Updated:</strong> <%= new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                    
                    <h2 class="fw-bold mb-3">What Are Cookies?</h2>
                    <p class="mb-4">
                        Cookies are small text files that are placed on your computer or mobile device when you visit a website. 
                        They are widely used to make websites work more efficiently and provide a better user experience.
                    </p>

                    <h2 class="fw-bold mb-3">How We Use Cookies</h2>
                    <p class="mb-3"><%= appName %> uses cookies for the following purposes:</p>
                    
                    <h4 class="fw-bold mb-3">1. Essential Cookies</h4>
                    <p class="mb-4">
                        These cookies are necessary for the website to function properly. They enable core functionality such as 
                        security, network management, and accessibility. You cannot opt-out of these cookies.
                    </p>
                    <ul class="mb-4">
                        <li>Session management</li>
                        <li>User authentication</li>
                        <li>Security features</li>
                        <li>Load balancing</li>
                    </ul>

                    <h4 class="fw-bold mb-3">2. Performance Cookies</h4>
                    <p class="mb-4">
                        These cookies collect information about how visitors use our website, such as which pages are visited most often. 
                        This data helps us improve our website's performance.
                    </p>
                    <ul class="mb-4">
                        <li>Page visit tracking</li>
                        <li>Error monitoring</li>
                        <li>Loading time analysis</li>
                        <li>User behavior patterns</li>
                    </ul>

                    <h4 class="fw-bold mb-3">3. Functionality Cookies</h4>
                    <p class="mb-4">
                        These cookies allow our website to remember choices you make and provide enhanced, personalized features.
                    </p>
                    <ul class="mb-4">
                        <li>Language preferences</li>
                        <li>Remember me functionality</li>
                        <li>Saved job searches</li>
                        <li>Customized job alerts</li>
                    </ul>

                    <h4 class="fw-bold mb-3">4. Targeting Cookies</h4>
                    <p class="mb-4">
                        These cookies are used to deliver advertisements more relevant to you and your interests.
                    </p>
                    <ul class="mb-4">
                        <li>Job recommendations</li>
                        <li>Relevant content suggestions</li>
                        <li>Career path insights</li>
                    </ul>

                    <h2 class="fw-bold mb-3">Types of Cookies We Use</h2>
                    
                    <div class="table-responsive mb-4">
                        <table class="table table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>Cookie Name</th>
                                    <th>Purpose</th>
                                    <th>Duration</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>session_id</td>
                                    <td>Maintains user session</td>
                                    <td>Session</td>
                                </tr>
                                <tr>
                                    <td>user_token</td>
                                    <td>Remembers logged-in users</td>
                                    <td>30 days</td>
                                </tr>
                                <tr>
                                    <td>preferences</td>
                                    <td>Stores user preferences</td>
                                    <td>1 year</td>
                                </tr>
                                <tr>
                                    <td>analytics</td>
                                    <td>Tracks website usage</td>
                                    <td>2 years</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <h2 class="fw-bold mb-3">Third-Party Cookies</h2>
                    <p class="mb-4">
                        We may also use third-party cookies from trusted partners to help us analyze website traffic and improve 
                        our services. These include:
                    </p>
                    <ul class="mb-4">
                        <li><strong>Google Analytics:</strong> For website analytics and user behavior tracking</li>
                        <li><strong>Social Media:</strong> For social sharing features</li>
                        <li><strong>Payment Processors:</strong> For secure payment processing</li>
                    </ul>

                    <h2 class="fw-bold mb-3">How to Control Cookies</h2>
                    <p class="mb-3">You can control and manage cookies in various ways:</p>
                    
                    <h4 class="fw-bold mb-3">Browser Settings</h4>
                    <p class="mb-4">
                        Most web browsers allow you to control cookies through their settings. You can set your browser to:
                    </p>
                    <ul class="mb-4">
                        <li>Block all cookies</li>
                        <li>Accept only first-party cookies</li>
                        <li>Clear cookies when you close your browser</li>
                        <li>Get notified when a cookie is set</li>
                    </ul>

                    <div class="alert alert-warning mb-4">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Note:</strong> Disabling cookies may affect your ability to use certain features of our website.
                    </div>

                    <h4 class="fw-bold mb-3">Browser-Specific Instructions</h4>
                    <ul class="mb-4">
                        <li><strong>Chrome:</strong> Settings → Privacy and security → Cookies and other site data</li>
                        <li><strong>Firefox:</strong> Options → Privacy & Security → Cookies and Site Data</li>
                        <li><strong>Safari:</strong> Preferences → Privacy → Cookies and website data</li>
                        <li><strong>Edge:</strong> Settings → Cookies and site permissions</li>
                    </ul>

                    <h2 class="fw-bold mb-3">Cookie Consent</h2>
                    <p class="mb-4">
                        When you first visit <%= appName %>, you will see a cookie banner. By clicking "Accept" or continuing 
                        to use our website, you consent to our use of cookies as described in this policy.
                    </p>

                    <h2 class="fw-bold mb-3">Changes to This Policy</h2>
                    <p class="mb-4">
                        We may update this Cookie Policy from time to time. Any changes will be posted on this page with an 
                        updated revision date. We encourage you to review this policy periodically.
                    </p>

                    <h2 class="fw-bold mb-3">Contact Us</h2>
                    <p class="mb-2">If you have any questions about our Cookie Policy, please contact us:</p>
                    <ul class="list-unstyled mb-4">
                        <li><i class="fas fa-envelope me-2 text-primary"></i> Email: privacy@rexjobs.in</li>
                        <li><i class="fas fa-phone me-2 text-primary"></i> Phone: +91 1234567890</li>
                        <li><i class="fas fa-map-marker-alt me-2 text-primary"></i> Address: 123 Business Street, City, India</li>
                    </ul>

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        For more information about how we handle your personal data, please read our 
                        <a href="/privacy-policy" class="alert-link">Privacy Policy</a>.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
