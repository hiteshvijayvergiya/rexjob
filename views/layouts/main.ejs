<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">

  <title><%= typeof seoTitle !== 'undefined' ? seoTitle : title %> | <%= appName || 'RexJobs' %></title>
  <meta name="description" content="<%= typeof seoDescription !== 'undefined' ? seoDescription : 'Find your dream job with RexJobs - Top job portal for IT, Marketing, Finance and more' %>">
  <meta name="keywords"    content="<%= typeof seoKeywords !== 'undefined' ? seoKeywords : 'jobs, careers, employment, recruitment' %>">

  <!-- OG -->
  <meta property="og:type"        content="website">
  <meta property="og:url"         content="<%= baseUrl || '' %>">
  <meta property="og:title"       content="<%= typeof seoTitle !== 'undefined' ? seoTitle : title %>">
  <meta property="og:description" content="<%= typeof seoDescription !== 'undefined' ? seoDescription : 'Find your dream job with RexJobs' %>">
  <meta property="og:image"       content="<%= (baseUrl||'') %>/images/og-image.jpg">
  <meta property="twitter:card"   content="summary_large_image">

  <link rel="icon" type="image/png" href="/images/favicon.png">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">

  <!-- Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <!-- Bootstrap (grid + modal + collapse utilities only; our CSS overrides visuals) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Our design system -->
  <link rel="stylesheet" href="/css/style.css">

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-ZSTG2DRSMZ"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-ZSTG2DRSMZ');</script>

  <!-- Google AdSense -->
  <!-- Google AdSense (production only) -->
    <% if (process.env.NODE_ENV === 'production') { %>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1722653562217355" crossorigin="anonymous"></script>
    <% } %>

  <%- typeof additionalCSS !== 'undefined' ? additionalCSS : '' %>
</head>
<body>

<!-- Navbar -->
<%- include('../partials/topnav') %>

<!-- Flash Messages -->
<% if (locals.success_msg && success_msg.length) { %>
<div class="page-flash">
  <div class="alert alert-success alert-dismissible">
    <i class="fas fa-check-circle"></i> <%= success_msg %>
    <button type="button" class="btn-close ms-auto" onclick="this.parentElement.remove()">×</button>
  </div>
</div>
<% } %>
<% if (locals.error_msg && error_msg.length) { %>
<div class="page-flash">
  <div class="alert alert-danger alert-dismissible">
    <i class="fas fa-exclamation-circle"></i> <%= error_msg %>
    <button type="button" class="btn-close ms-auto" onclick="this.parentElement.remove()">×</button>
  </div>
</div>
<% } %>

<main><%- body %></main>

<!-- Footer -->
<%- include('../partials/footer') %>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
// ── showToast ─────────────────────────────────────────────────────────────
function showToast(msg, type) {
  type = type || 'success';
  const colors = { success:'#059669', danger:'#dc2626', warning:'#d97706', info:'#0891b2' };
  const icons  = { success:'fa-check-circle', danger:'fa-times-circle', warning:'fa-exclamation-triangle', info:'fa-info-circle' };
  const el = document.createElement('div');
  el.style.cssText = `position:fixed;top:76px;right:1.25rem;z-index:99999;
    background:${colors[type]||colors.success};color:#fff;
    padding:.75rem 1.25rem;border-radius:10px;
    box-shadow:0 8px 30px rgba(0,0,0,.2);
    font-family:'DM Sans',sans-serif;font-size:.9rem;font-weight:600;
    display:flex;align-items:center;gap:.6rem;max-width:360px;
    animation:fadeUp .3s ease;`;
  el.innerHTML = `<i class="fas ${icons[type]||icons.success}"></i>${msg}`;
  document.body.appendChild(el);
  setTimeout(() => { el.style.opacity='0'; el.style.transition='opacity .3s'; setTimeout(()=>el.remove(),300); }, 3200);
}

// ── Navbar mobile toggle ──────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', function() {
  const toggler = document.querySelector('.navbar-toggler');
  const collapse = document.querySelector('.navbar-collapse');
  if (toggler && collapse) {
    toggler.addEventListener('click', () => collapse.classList.toggle('show'));
  }

  // Active link highlight
  const path = window.location.pathname;
  document.querySelectorAll('.nav-link, .sidebar-link').forEach(link => {
    const href = link.getAttribute('href');
    if (href && (href === path || (href !== '/' && path.startsWith(href)))) {
      link.classList.add('active');
    }
  });

  // Auto-dismiss flash after 4s
  setTimeout(() => {
    document.querySelectorAll('.page-flash .alert').forEach(el => {
      el.style.opacity = '0'; el.style.transition = 'opacity .4s';
      setTimeout(() => el.remove(), 400);
    });
  }, 4000);
});
</script>

<%- typeof additionalJS !== 'undefined' ? additionalJS : '' %>
</body>
</html>
